{
  "folders": [
    { "path": "Frontend" },
    { "path": "Backend" },
    { "path": "Simulations" }
  ],
  "settings": {
    "dotnet.defaultSolution": "AstPIE.slnx"
  },
  "extensions": {
    "recommendations": [
      "astro-build.astro-vscode",
      "ms-dotnettools.csdevkit",
      "ms-ossdata.vscode-pgsql",
      "esbenp.prettier-vscode"
    ]
  },
  "launch": {
    "version": "0.2.0",
    "configurations": [
      {
        "name": "Frontend",
        "type": "node-terminal",
        "request": "launch",
        "command": "npm run dev",
        "cwd": "${workspaceFolder:Frontend}"
      },
      {
        "name": "Backend",
        "type": "dotnet",
        "request": "launch",
        "projectPath": "${workspaceFolder:Backend}/AstPIE.Api/AstPIE.Api.csproj"
      }
    ],
    "compounds": [
      {
        "name": "Full site",
        "configurations": ["Backend", "Frontend"],
        "stopAll": true
      }
    ]
  }
}
