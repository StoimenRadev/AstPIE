---
// The page of one mission or mystery: a photo header, key facts, the story in
// chapters with a bar to jump between them, the people, pictures and the physics.
import Chapters from './Chapters.astro';
import Photo from './Photo.astro';
import { t } from '../i18n/t';
import { getEntries, getPerson } from '../lib/api';
import type { Entry } from '../lib/api';
import { chapterView } from '../lib/chapters';
import { formatDate, outcomeLabel, statusLabel } from '../lib/format';
import { countryOf, firstSentence } from '../lib/scenes';

interface Props
{
	entry: Entry;
	// For example "/explore/missions"
	basePath: string;
	// The drawing shown where there is no photo
	scene: string;
}

const { entry, basePath, scene } = Astro.props;
const isMission = entry.kind === 'Mission';

const chapters = entry.chapters.map((chapter, index) => chapterView(index, chapter.title, chapter.summary, chapter.body));

// The people, with their photo and a short bio
const people = [];
for (const link of entry.people)
{
	const person = await getPerson(link.personId);
	people.push({ name: person.fullName, role: link.role, photoUrl: person.photoUrl, bio: firstSentence(person.bio).first });
}

// Key facts under the header
const facts = [];
if (entry.agency !== null)
{
	facts.push({ label: t('entry.agency'), value: entry.agency });
}
if (entry.startDate !== null)
{
	let label = t('entry.launched');
	if (!isMission)
	{
		label = t('entry.detected');
	}
	facts.push({ label: label, value: formatDate(entry.startDate) });
}
if (entry.endDate !== null)
{
	facts.push({ label: t('entry.ended'), value: formatDate(entry.endDate) });
}
if (entry.missionOutcome !== null)
{
	facts.push({ label: t('entry.outcome'), value: outcomeLabel(entry.missionOutcome) });
}
if (entry.evidenceStatus !== null)
{
	facts.push({ label: t('entry.status'), value: statusLabel(entry.evidenceStatus) });
}

let countryColour = '';
const country = countryOf(entry.agency);
if (country === 'ussr')
{
	countryColour = 'var(--ussr)';
}
if (country === 'usa')
{
	countryColour = 'var(--usa)';
}

// Other stories of the same kind
const others = (await getEntries(entry.kind)).filter((e) => e.slug !== entry.slug).slice(0, 3);

let allLabel = t('entry.allMissions');
if (!isMission)
{
	allLabel = t('entry.allMysteries');
}
---

<section class="story-hero wrap">
	<a class="back" href={basePath}>← {allLabel}</a>
	<div class="grid">
		<div>
			<h1 class="title">{entry.title}</h1>
			<p class="lede">{entry.summary}</p>
			{countryColour !== '' && <div class="tagline"><span><span class="dot" style={'background:' + countryColour}></span>{entry.agency}</span></div>}
		</div>
		<div class="hero-photo"><Photo src={entry.coverImageUrl} scene={scene} className="" /></div>
	</div>
	{facts.length > 0 && (
		<dl class="sheet">
			{facts.map((fact) => <div><dt>{fact.label}</dt><dd>{fact.value}</dd></div>)}
		</dl>
	)}
</section>

<Chapters chapters={chapters} simulations={[]} />

{people.length > 0 && (
	<section class="ch" id="people">
		<div class="ch-head"><span class="ch-num">{String(chapters.length + 1).padStart(2, '0')}</span><div><h2>{t('entry.people')}</h2></div></div>
		<div class="wide">
			<div class="people">
				{people.map((person) => (
					<div class="person">
						<Photo src={person.photoUrl} scene={scene} className="" />
						<div><h4>{person.name}</h4><div class="role">{person.role}</div><p>{person.bio}</p></div>
					</div>
				))}
			</div>
		</div>
	</section>
)}

{entry.media.length > 0 && (
	<section class="wrap" style="padding-top:120px">
		<div class="section-title"><div><h2>{t('entry.media')}</h2></div></div>
		<div class="pair">
			{entry.media.map((media) => (
				<figure>
					{media.type === 'Image' && <Photo src={media.url} scene={scene} className="r43" />}
					{media.type === 'Video' && <video class="photo r43" src={media.url} controls></video>}
					{(media.type === 'Audio' || media.type === 'Signal') && <audio src={media.url} controls style="width:100%"></audio>}
					<figcaption><b>{media.title}.</b> {media.caption} {media.credit}</figcaption>
				</figure>
			))}
		</div>
	</section>
)}

{entry.relatedTopic !== null && (
	<section class="wrap" style="padding-top:120px">
		<div class="section-title"><div><h2>{t('entry.physics')}</h2><p>{t('entry.physicsText')}</p></div><a class="more" href={'/learn/' + entry.relatedTopic.slug}>{entry.relatedTopic.title} →</a></div>
	</section>
)}

{others.length > 0 && (
	<section class="wrap after">
		<div class="section-title"><div><h2>{t('entry.keepExploring')}</h2></div><a class="more" href={basePath}>{allLabel} →</a></div>
		<div class="tiles">
			{others.map((other) => (
				<a class="tile" href={basePath + '/' + other.slug}><Photo src={other.coverImageUrl} scene={scene} className="" /><h4>{other.title}</h4><p>{other.summary}</p></a>
			))}
		</div>
	</section>
)}
