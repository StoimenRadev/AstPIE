---
// The page of one mission or mystery, laid out like an encyclopedia article:
// the route on the left, the article in the middle, the infobox on the right.
import CaseRoute from './CaseRoute.astro';
import type { RouteItem } from './CaseRoute.astro';
import Parts from './Parts.astro';
import PersonCard from './PersonCard.astro';
import Slot from './Slot.astro';
import { t } from '../i18n/t';
import { getPerson } from '../lib/api';
import type { Entry } from '../lib/api';
import { firstSentence } from '../lib/branches';
import { chapterView } from '../lib/chapters';
import { countryName } from '../lib/country';
import { formatDate, outcomeLabel, statusLabel } from '../lib/format';

interface Props
{
	entry: Entry;
}

const { entry } = Astro.props;
const isMission = entry.kind === 'Mission';
const chapters = entry.chapters.map((chapter, index) => chapterView(index, chapter.title, chapter.summary, chapter.body));

// ---------- People, with what the card needs ----------
function initials(name: string): string
{
	return name.split(' ').filter((w) => w !== '').map((w) => w[0]).slice(0, 2).join('').toUpperCase();
}

function lifeYears(birth: string | null, death: string | null): string
{
	if (birth === null)
	{
		return '';
	}
	let text = ' · ' + birth.substring(0, 4);
	if (death !== null)
	{
		text = text + '–' + death.substring(0, 4);
	}
	return text;
}

const people = [];
for (const link of entry.people)
{
	const person = await getPerson(link.personId);
	const otherPages = person.entries.filter((e) => e.slug !== entry.slug).map((e) => e.title);
	let also = t('person.noOtherPages');
	if (otherPages.length > 0)
	{
		also = t('person.alsoOn') + ' ' + otherPages.join(', ');
	}
	people.push({
		name: person.fullName,
		role: link.role,
		card: link.role + lifeYears(person.birthDate, person.deathDate),
		photo: person.photoUrl,
		initials: initials(person.fullName),
		bio: person.bio,
		also: also
	});
}

// ---------- The status under the title ----------
let status = '';
let statusColour = 'blue';
if (entry.missionOutcome !== null)
{
	status = outcomeLabel(entry.missionOutcome);
	if (entry.missionOutcome === 'Ongoing')
	{
		statusColour = 'orange';
	}
	if (entry.missionOutcome === 'PartialSuccess' || entry.missionOutcome === 'Failure')
	{
		statusColour = 'yellow';
	}
}
if (entry.evidenceStatus !== null)
{
	status = statusLabel(entry.evidenceStatus);
	statusColour = 'orange';
	if (entry.evidenceStatus === 'Debunked')
	{
		statusColour = 'blue';
	}
}

let kindLabel = t('entry.mission');
if (!isMission)
{
	kindLabel = t('entry.mystery');
}

let years = '';
if (entry.startDate !== null)
{
	years = entry.startDate.substring(0, 4);
	if (entry.endDate !== null && entry.endDate.substring(0, 4) !== years)
	{
		years = years + ' – ' + entry.endDate.substring(0, 4);
	}
	if (entry.endDate === null && entry.missionOutcome === 'Ongoing')
	{
		years = years + ' – ' + t('common.now');
	}
}

// ---------- The infobox ----------
interface Fact
{
	label: string;
	value: string;
}
const facts: Fact[] = [];
if (entry.agency !== null)
{
	facts.push({ label: t('entry.agency'), value: entry.agency });
}
if (isMission && countryName(entry.agency) !== entry.agency)
{
	facts.push({ label: t('entry.country'), value: countryName(entry.agency) });
}
if (entry.startDate !== null)
{
	let label = t('entry.launched');
	if (!isMission)
	{
		label = t('entry.detected');
	}
	facts.push({ label: label, value: formatDate(entry.startDate) });
}
if (entry.endDate !== null)
{
	facts.push({ label: t('entry.ended'), value: formatDate(entry.endDate) });
}
if (entry.missionOutcome === 'Ongoing')
{
	facts.push({ label: t('entry.ended'), value: t('entry.stillGoing') });
}
if (status !== '')
{
	let label = t('entry.outcome');
	if (!isMission)
	{
		label = t('entry.status');
	}
	facts.push({ label: label, value: status });
}

// ---------- The route ----------
const route: RouteItem[] = chapters.map((chapter, index) =>
{
	let note = '';
	const dateLabel = entry.chapters[index].dateLabel;
	if (dateLabel !== null)
	{
		note = dateLabel;
	}
	return { id: chapter.id, title: chapter.title, note: note, summary: chapter.summary, extra: false };
});
if (people.length > 0)
{
	route.push({ id: 'people', title: t('entry.people'), note: '', summary: '', extra: true });
}
const images = entry.media.filter((m) => m.type === 'Image');
const sounds = entry.media.filter((m) => m.type !== 'Image');
if (entry.media.length > 0)
{
	route.push({ id: 'media', title: t('entry.media'), note: '', summary: '', extra: true });
}
if (entry.relatedTopic !== null)
{
	route.push({ id: 'physics', title: t('entry.physics'), note: '', summary: '', extra: true });
}
---

<div class="wrap case">
	<CaseRoute heading={t('entry.route')} items={route} />

	<article class="case-main">
		<h1>{entry.title}</h1>
		<div class="meta kind">
			<span class="dot" style={'--dc:var(--acc)'}>{kindLabel}</span>
			{isMission && countryName(entry.agency) !== '' && <span>{countryName(entry.agency)}</span>}
			{years !== '' && <span>{years}</span>}
		</div>
		<p class="intro">{entry.summary}</p>

		{chapters.map((chapter, index) => (
			<section class="sect" id={chapter.id}>
				<h2>{chapter.title}</h2>
				{chapter.summary !== '' && <p class="when">{chapter.summary}</p>}
				<Parts parts={chapter.parts} simulations={[]} />
				{index < chapters.length - 1 && (
					<a class="next" href={'#' + chapters[index + 1].id}><span>{t('entry.next')}</span><b>{chapters[index + 1].title}</b><span class="go"><svg><use href="#i-down" /></svg></span></a>
				)}
			</section>
		))}

		{people.length > 0 && (
			<section class="sect" id="people">
				<h2>{t('entry.people')}</h2>
				<p class="when">{t('entry.peopleText')}</p>
				<div class="people-row">
					{people.map((person) => (
						<button class="person" type="button" data-person={person.name} data-role={person.card} data-photo={person.photo} data-initials={person.initials} data-bio={person.bio} data-also={person.also}>
							<Slot src={person.photo} ratio="1 / 1" empty={person.initials} className="" />
							<b>{person.name}</b><span>{person.role}</span>
						</button>
					))}
				</div>
			</section>
		)}

		{entry.media.length > 0 && (
			<section class="sect" id="media">
				<h2>{t('entry.media')}</h2>
				{images.length > 0 && (
					<div class="gal">
						{images.map((media) => (
							<figure>
								<Slot src={media.url} ratio="4 / 3" empty="" className="natural" />
								<figcaption><b>{media.title}</b> {media.caption}{media.credit !== null && <span class="cr">{media.credit}</span>}</figcaption>
							</figure>
						))}
					</div>
				)}
				{sounds.map((media) => (
					<figure style="margin-top:18px">
						{media.type === 'Video' && <video src={media.url} controls style="width:100%;border-radius:12px"></video>}
						{media.type !== 'Video' && <audio src={media.url} controls style="width:100%"></audio>}
						<figcaption><b>{media.title}</b> {media.caption}{media.credit !== null && <span class="cr">{media.credit}</span>}</figcaption>
					</figure>
				))}
			</section>
		)}

		{entry.relatedTopic !== null && (
			<section class="sect" id="physics">
				<h2>{t('entry.physics')}</h2>
				<a class="physics" href={'/learn/' + entry.relatedTopic.slug}>
					<div><small>{t('nav.learn')}</small><strong>{entry.relatedTopic.title}</strong><span>{t('entry.physicsText')}</span></div>
					<span class="arr"><svg><use href="#i-arrow" /></svg></span>
				</a>
			</section>
		)}
	</article>

	<aside class="infobox">
		<Slot src={entry.coverImageUrl} ratio="4 / 3" empty={t('common.noImage')} className="natural" />
		<h3>{entry.title}</h3>
		{status !== '' && <div class="status"><span class={'dot ' + statusColour}>{status}</span></div>}
		<dl>
			<div class="grp">{kindLabel}</div>
			{facts.map((fact) => <div><dt>{fact.label}</dt><dd>{fact.value}</dd></div>)}
			{people.length > 0 && <div class="grp">{t('entry.people')}</div>}
		</dl>
		{people.length > 0 && (
			<div class="ppl">
				{people.slice(0, 4).map((person) => (
					<button type="button" data-person={person.name} data-role={person.card} data-photo={person.photo} data-initials={person.initials} data-bio={person.bio} data-also={person.also}>
						<Slot src={person.photo} ratio="1 / 1" empty={person.initials} className="" />
						<div><b>{person.name}</b><span>{person.role}</span></div>
					</button>
				))}
			</div>
		)}
	</aside>
</div>

<PersonCard />
