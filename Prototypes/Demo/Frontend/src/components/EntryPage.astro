---
// The page of one mission or mystery: header, timeline, people, chapters, physics link
import EntryBadge from './EntryBadge.astro';
import PeopleList from './PeopleList';
import type { PersonCardData, PeopleLabels } from './PeopleList';
import { t } from '../i18n/t';
import { getPerson } from '../lib/api';
import type { Entry } from '../lib/api';
import { formatDate, formatDateRange, outcomeLabel, statusLabel } from '../lib/format';
import { renderMarkdown } from '../lib/markdown';

interface Props
{
	entry: Entry;
	// For example "/explore/missions"
	basePath: string;
}

const { entry, basePath } = Astro.props;

// Everything the people cards show is loaded here, on the server
const people: PersonCardData[] = [];
for (const link of entry.people)
{
	const person = await getPerson(link.personId);

	let lifespan = '';
	if (person.birthDate !== null)
	{
		lifespan = t('person.born') + ' ' + formatDate(person.birthDate);
		if (person.deathDate !== null)
		{
			lifespan = lifespan + ' · ' + t('person.died') + ' ' + formatDate(person.deathDate);
		}
	}

	const otherEntries = [];
	for (const other of person.entries)
	{
		if (other.slug !== entry.slug)
		{
			let section = '/explore/missions/';
			if (other.kind === 'Mystery')
			{
				section = '/explore/mysteries/';
			}
			otherEntries.push({ href: section + other.slug, title: other.title, role: other.role });
		}
	}

	people.push({
		id: person.id,
		fullName: person.fullName,
		role: link.role,
		isCrew: link.isCrew,
		photoUrl: person.photoUrl,
		nationality: person.nationality,
		lifespan: lifespan,
		bio: person.bio,
		otherEntries: otherEntries
	});
}

const peopleLabels: PeopleLabels = {
	crew: t('entry.crew'),
	nationality: t('person.nationality'),
	otherEntries: t('person.otherEntries'),
	close: t('common.close')
};

let factLabel = t('entry.outcome');
let factValue = '';
if (entry.missionOutcome !== null)
{
	factValue = outcomeLabel(entry.missionOutcome);
}
if (entry.evidenceStatus !== null)
{
	factLabel = t('entry.status');
	factValue = statusLabel(entry.evidenceStatus);
}

const chapters = [];
for (let i = 0; i < entry.chapters.length; i++)
{
	const chapter = entry.chapters[i];
	chapters.push({
		id: 'chapter-' + (i + 1),
		title: chapter.title,
		dateLabel: chapter.dateLabel,
		bodyHtml: renderMarkdown(chapter.body)
	});
}
---

<article>
	<p class="back"><a href={basePath}>← {t('entry.back')}</a></p>

	<header>
		<h1>{entry.title}</h1>
		<p class="summary">{entry.summary}</p>

		<dl class="facts">
			{entry.startDate !== null && (
				<div>
					<dt>{t('entry.dates')}</dt>
					<dd>{formatDateRange(entry.startDate, entry.endDate, entry.missionOutcome === 'Ongoing')}</dd>
				</div>
			)}
			{entry.agency !== null && (
				<div>
					<dt>{t('entry.agency')}</dt>
					<dd>{entry.agency}</dd>
				</div>
			)}
			{factValue !== '' && (
				<div>
					<dt>{factLabel}</dt>
					<dd><EntryBadge missionOutcome={entry.missionOutcome} evidenceStatus={entry.evidenceStatus} /></dd>
				</div>
			)}
		</dl>
	</header>

	{chapters.length > 0 && (
		<section>
			<h2>{t('entry.timeline')}</h2>
			<ol class="timeline">
				{chapters.map((chapter) => (
					<li>
						<span class="when">{chapter.dateLabel}</span>
						<a href={'#' + chapter.id}>{chapter.title}</a>
					</li>
				))}
			</ol>
		</section>
	)}

	{people.length > 0 && (
		<section>
			<h2>{t('entry.people')}</h2>
			<PeopleList client:load people={people} labels={peopleLabels} />
		</section>
	)}

	{chapters.map((chapter) => (
		<section class="chapter" id={chapter.id}>
			<h2>{chapter.title}</h2>
			{chapter.dateLabel !== null && <p class="when">{chapter.dateLabel}</p>}
			<div set:html={chapter.bodyHtml} />
		</section>
	))}

	{entry.media.length > 0 && (
		<section>
			<h2>{t('entry.media')}</h2>
			<ul>
				{entry.media.map((media) => (
					<li><a href={media.url}>{media.title}</a></li>
				))}
			</ul>
		</section>
	)}

	{entry.relatedTopic !== null && (
		<section class="physics">
			<h2>{t('entry.physics')}</h2>
			<a href={'/learn/' + entry.relatedTopic.slug}>{entry.relatedTopic.title} →</a>
		</section>
	)}
</article>

<style>
	article {
		max-width: 44rem;
	}

	.back {
		margin: 0;
		font-size: 0.875rem;
	}

	.summary {
		font-size: 1.25rem;
		color: var(--color-muted);
	}

	.facts {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-4);
		margin: var(--space-4) 0 0;
	}

	.facts dt {
		color: var(--color-muted);
		font-size: 0.8125rem;
	}

	.facts dd {
		margin: 0;
		font-weight: 600;
	}

	section {
		margin-top: var(--space-5);
	}

	.timeline {
		margin: 0;
		padding: 0;
		list-style: none;
		border-left: 2px solid var(--color-border);
	}

	.timeline li {
		position: relative;
		padding: 0 0 var(--space-3) var(--space-4);
	}

	/* A dot on the line for each chapter */
	.timeline li::before {
		content: '';
		position: absolute;
		left: -6px;
		top: 0.45em;
		width: 10px;
		height: 10px;
		border-radius: 50%;
		background: var(--color-link);
	}

	.when {
		display: block;
		color: var(--color-muted);
		font-size: 0.875rem;
	}

	.chapter .when {
		margin-top: calc(-1 * var(--space-2));
	}

	.physics a {
		font-weight: 600;
	}
</style>
