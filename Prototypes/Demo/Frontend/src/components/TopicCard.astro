---
// A card for one Learn topic. Its picture comes from its branch: every topic of
// "Classical mechanics" shares one scene, another branch gets its own.
import BranchMotif from './branches/BranchMotif.astro';
import type { TopicListItem } from '../lib/api';

interface Props
{
	topic: TopicListItem;
}

const { topic } = Astro.props;
---

<a class="topic-card" href={'/learn/' + topic.slug}>
	<BranchMotif branch={topic.branch} />
	<div class="text">
		<h3>{topic.title}</h3>
		<p>{topic.summary}</p>
	</div>
</a>

<style>
	.topic-card {
		display: block;
		overflow: hidden;
		border: 1px solid var(--color-border);
		border-radius: 0.5rem;
		color: var(--color-text);
		text-decoration: none;
	}

	.topic-card:hover {
		background: var(--color-surface);
	}

	.text {
		padding: var(--space-3) var(--space-4) var(--space-4);
	}

	h3 {
		margin: 0;
	}

	p {
		margin-bottom: 0;
		color: var(--color-muted);
	}
</style>
