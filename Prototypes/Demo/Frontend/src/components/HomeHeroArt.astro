---
// The home page picture: the Earth from orbit, the Moon, a satellite and a rocket
---

<svg viewBox="0 0 1600 900" preserveAspectRatio="xMidYMax slice" aria-hidden="true">
	<defs>
		<radialGradient id="hh-sky" cx="50%" cy="20%" r="80%"><stop offset="0" stop-color="#3A2F55"/><stop offset="0.5" stop-color="#251F35"/><stop offset="1" stop-color="#1C1925"/></radialGradient>
		<radialGradient id="hh-neb1" cx="0.5" cy="0.5" r="0.5"><stop offset="0" stop-color="#7A5FA8" stop-opacity="0.3"/><stop offset="1" stop-color="#7A5FA8" stop-opacity="0"/></radialGradient>
		<radialGradient id="hh-neb2" cx="0.5" cy="0.5" r="0.5"><stop offset="0" stop-color="#3E9A8F" stop-opacity="0.18"/><stop offset="1" stop-color="#3E9A8F" stop-opacity="0"/></radialGradient>
		<radialGradient id="hh-atmo" gradientUnits="userSpaceOnUse" cx="800" cy="1440" r="880"><stop offset="0.87" stop-color="#8CC9EA" stop-opacity="0"/><stop offset="0.895" stop-color="#8CC9EA" stop-opacity="0.55"/><stop offset="0.935" stop-color="#8CC9EA" stop-opacity="0.14"/><stop offset="1" stop-color="#8CC9EA" stop-opacity="0"/></radialGradient>
		<linearGradient id="hh-ocean" x1="0.2" y1="0" x2="0.8" y2="0.6"><stop offset="0" stop-color="#3E8DB9"/><stop offset="1" stop-color="#245A80"/></linearGradient>
		<linearGradient id="hh-night" gradientUnits="userSpaceOnUse" x1="560" y1="640" x2="1260" y2="980"><stop offset="0.35" stop-color="#0D0F1C" stop-opacity="0"/><stop offset="0.65" stop-color="#0D0F1C" stop-opacity="0.66"/><stop offset="1" stop-color="#0D0F1C" stop-opacity="0.9"/></linearGradient>
		<linearGradient id="hh-rim" gradientUnits="userSpaceOnUse" x1="120" y1="900" x2="1100" y2="660"><stop offset="0" stop-color="#CFEAF7" stop-opacity="0"/><stop offset="0.4" stop-color="#CFEAF7" stop-opacity="0.9"/><stop offset="0.8" stop-color="#CFEAF7" stop-opacity="0.35"/><stop offset="1" stop-color="#CFEAF7" stop-opacity="0"/></linearGradient>
		<linearGradient id="hh-trail" gradientUnits="userSpaceOnUse" x1="1170" y1="700" x2="1360" y2="430"><stop offset="0" stop-color="#F3E9D6" stop-opacity="0"/><stop offset="1" stop-color="#F3E9D6" stop-opacity="0.85"/></linearGradient>
		<linearGradient id="hh-moonshade" x1="0" y1="0" x2="1" y2="1"><stop offset="0.45" stop-color="#14121B" stop-opacity="0"/><stop offset="0.72" stop-color="#14121B" stop-opacity="0.75"/></linearGradient>
		<clipPath id="hh-earth"><circle cx="800" cy="1440" r="800"/></clipPath>
		<clipPath id="hh-moon"><circle cx="240" cy="200" r="54"/></clipPath>
	</defs>
	<rect width="1600" height="900" fill="url(#hh-sky)"/>
	<ellipse cx="1180" cy="300" rx="520" ry="300" fill="url(#hh-neb1)"/>
	<ellipse cx="340" cy="520" rx="460" ry="260" fill="url(#hh-neb2)"/>
	<g class="stars" data-n="360" data-w="1600" data-h="900" data-seed="3"></g>
	<use href="#spark" x="1180" y="120" width="30" height="30"/>
	<use href="#spark" x="380" y="400" width="22" height="22"/>
	<use href="#spark" x="1480" y="560" width="24" height="24"/>
	<use href="#spark" x="110" y="640" width="18" height="18"/>

	<!-- orbit, the half behind the Earth -->
	<path d="M-100 940 A900 340 0 0 1 1700 940" fill="none" stroke="#F3E9D6" stroke-opacity="0.35" stroke-width="2" stroke-dasharray="3 10" stroke-linecap="round"/>

	<!-- Earth, centred -->
	<circle cx="800" cy="1440" r="880" fill="url(#hh-atmo)"/>
	<circle cx="800" cy="1440" r="800" fill="url(#hh-ocean)"/>
	<g clip-path="url(#hh-earth)">
		<path d="M300 800 q70 -80 200 -76 q140 6 176 80 q28 70 -46 112 q-80 46 -176 12 q-70 -26 -116 -70 q-48 -36 -38 -58z" fill="#5E9E72"/>
		<path d="M344 778 q60 -40 140 -34 q-70 22 -98 64z" fill="#86BC8C"/>
		<path d="M820 690 q110 -56 230 -22 q110 34 84 116 q-24 70 -146 70 q-120 -2 -168 -70 q-36 -60 0 -94z" fill="#5E9E72"/>
		<path d="M856 686 q84 -30 168 -8 q-72 8 -120 48z" fill="#86BC8C"/>
		<path d="M1150 820 q90 -24 160 34 q56 56 12 112 q-68 46 -136 0 q-56 -46 -36 -146z" fill="#5E9E72"/>
		<path d="M620 690 q110 -40 240 -36" stroke="#F7F2E8" stroke-width="22" stroke-linecap="round" fill="none" opacity="0.85"/>
		<path d="M200 760 q70 -26 150 -24" stroke="#F7F2E8" stroke-width="16" stroke-linecap="round" fill="none" opacity="0.8"/>
		<path d="M700 840 q90 -22 180 -6 q60 10 110 0" stroke="#F7F2E8" stroke-width="18" stroke-linecap="round" fill="none" opacity="0.75"/>
		<path d="M1080 700 q70 -10 140 10" stroke="#F7F2E8" stroke-width="15" stroke-linecap="round" fill="none" opacity="0.65"/>
		<rect x="0" y="620" width="1600" height="300" fill="url(#hh-night)"/>
		<g fill="#F7D58A"><circle cx="1240" cy="860" r="2.4"/><circle cx="1258" cy="872" r="1.8"/><circle cx="1272" cy="852" r="2"/><circle cx="1310" cy="886" r="2.2"/><circle cx="1214" cy="884" r="1.6"/><circle cx="1350" cy="840" r="1.8"/><circle cx="1374" cy="870" r="2.4"/><circle cx="1190" cy="846" r="1.6"/><circle cx="1290" cy="820" r="1.6"/><circle cx="1400" cy="890" r="2"/></g>
	</g>

	<!-- rocket climbing out of the atmosphere on the right -->
	<path d="M1168 700 C 1190 600, 1260 500, 1350 438" fill="none" stroke="url(#hh-trail)" stroke-width="14" stroke-linecap="round"/>
	<g fill="#F3E9D6"><circle cx="1168" cy="700" r="22" opacity="0.32"/><circle cx="1150" cy="712" r="15" opacity="0.28"/><circle cx="1190" cy="712" r="13" opacity="0.26"/></g>
	<g transform="translate(1368 420) rotate(52)"><use href="#rocket" x="-30" y="-85" width="60" height="200"/></g>

	<!-- satellite on the orbit -->
	<g transform="translate(222 680) rotate(-22)">
		<rect x="-46" y="-8" width="32" height="16" rx="2" fill="#4E6A7C"/><rect x="14" y="-8" width="32" height="16" rx="2" fill="#4E6A7C"/>
		<path d="M-46 -2.5 h32 M-46 2.5 h32 M14 -2.5 h32 M14 2.5 h32" stroke="#6F8DA0" stroke-width="1.2"/>
		<rect x="-14" y="-1.5" width="28" height="3" fill="#8A8496"/>
		<rect x="-11" y="-12" width="22" height="24" rx="3" fill="#E8A54B"/><rect x="0" y="-12" width="11" height="24" rx="2" fill="#C98B3A"/>
		<circle cx="0" cy="-18" r="4" fill="#E9DFCB"/>
	</g>

	<g transform="translate(10 290)">
	<circle cx="240" cy="200" r="54" fill="#E4DBCB"/>
	<g clip-path="url(#hh-moon)">
		<path d="M202 182 q20 -16 40 -6 q10 18 -10 26 q-22 6 -30 -20z" fill="#CFC4B0"/>
		<path d="M250 214 q18 -6 28 8 q-2 18 -20 16 q-16 -6 -8 -24z" fill="#CFC4B0"/>
		<circle cx="266" cy="176" r="7" fill="#CFC4B0"/>
		<rect x="180" y="140" width="130" height="130" fill="url(#hh-moonshade)"/>
	</g>
	</g>
</svg>
