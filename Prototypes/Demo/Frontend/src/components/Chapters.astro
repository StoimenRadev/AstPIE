---
// The chapter bar and the chapters of a long page. Widgets named in the text
// with [[name]] are put in their place.
import SimulationPlayer from './SimulationPlayer';
import SputnikRadio from './widgets/SputnikRadio.astro';
import SignalDecoder from './widgets/SignalDecoder.astro';
import { simulationLabels } from '../i18n/simulationLabels';
import type { Simulation } from '../lib/api';
import type { ChapterView } from '../lib/chapters';

interface Props
{
	chapters: ChapterView[];
	// Shown where a chapter says [[simulation]]; empty when the page has none
	simulations: Simulation[];
}

const { chapters, simulations } = Astro.props;
const labels = simulationLabels();

// Text that already has its own layout blocks is used as it is; plain text goes in the reading column
const LAID_OUT = /class="(read|wide|pull)[ "]/;
---

{chapters.length > 0 && (
	<nav class="sectors" data-sectors>
		<div class="wrap">
			{chapters.map((chapter) => <button type="button" data-jump={chapter.id}>{chapter.title}</button>)}
		</div>
		<div class="progress"></div>
	</nav>
)}

{chapters.map((chapter) => (
	<section class="ch" id={chapter.id}>
		<div class="ch-head">
			<span class="ch-num">{chapter.number}</span>
			<div>
				<h2>{chapter.title}</h2>
				{chapter.summary !== '' && <p>{chapter.summary}</p>}
			</div>
		</div>
		{chapter.parts.map((part) => (
			<>
				{part.kind === 'html' && LAID_OUT.test(part.html) && <Fragment set:html={part.html} />}
				{part.kind === 'html' && !LAID_OUT.test(part.html) && <div class="read" set:html={part.html} />}
				{part.kind === 'radio' && <div class="wide"><SputnikRadio /></div>}
				{part.kind === 'decoder' && <div class="wide"><SignalDecoder /></div>}
				{part.kind === 'simulation' && (
					<div class="wide">
						{simulations.map((simulation) => (
							<SimulationPlayer
								client:load
								title={simulation.title}
								learningGoal={simulation.learningGoal}
								buildUrl={simulation.buildUrl}
								thumbnailUrl={simulation.thumbnailUrl}
								labels={labels}
							/>
						))}
					</div>
				)}
			</>
		))}
	</section>
))}
