---
// A picture slot: the real photo when there is one, the section drawing when
// there is not (or when the photo fails to load).
import Scene from './Scene.astro';

interface Props
{
	// Empty when there is no photo yet
	src: string;
	// The drawing shown behind or instead of the photo
	scene: string;
	// Extra classes, for example "r169" (16:9) or "contain"
	className: string;
}

const { src, scene, className } = Astro.props;
---

<div class={'photo ' + className}>
	<Scene name={scene} className="fallback" />
	{src !== '' && <img src={src} alt="" loading="lazy" onload="this.parentNode.classList.add('loaded')" onerror="this.parentNode.classList.add('missing')" />}
</div>
