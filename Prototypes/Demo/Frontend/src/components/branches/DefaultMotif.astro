---
// For branches that don't have their own scene yet: simple shapes in the palette
---

<div class="art" aria-hidden="true">
	<svg viewBox="0 0 320 160" xmlns="http://www.w3.org/2000/svg">
		<rect class="sky" x="0" y="0" width="320" height="160" />
		<circle class="shape coral" cx="80" cy="80" r="28" />
		<rect class="shape ochre" x="140" y="54" width="52" height="52" rx="4" />
		<polygon class="shape teal" points="236,106 264,54 292,106" />
	</svg>
</div>

<style>
	.art {
		width: 100%;
		aspect-ratio: 2 / 1;
	}

	svg {
		display: block;
		width: 100%;
		height: auto;
	}

	.sky {
		fill: var(--art-cream);
	}

	.coral {
		fill: var(--art-coral);
	}

	.ochre {
		fill: var(--art-ochre);
	}

	.teal {
		fill: var(--art-teal);
	}
</style>
