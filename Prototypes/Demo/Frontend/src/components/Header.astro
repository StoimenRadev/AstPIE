---
import { t } from '../i18n/t';

const path = Astro.url.pathname;

// The menu item of the section the page belongs to is underlined
const links = [
	{ href: '/learn', label: t('nav.learn'), on: path.startsWith('/learn') },
	{ href: '/explore', label: t('nav.explore'), on: path.startsWith('/explore') }
];
---

<header class="top" id="top">
	<div class="wrap">
		<a class="logo" href="/">
			<svg width="30" height="30" viewBox="0 0 30 30" aria-hidden="true"><circle cx="15" cy="15" r="9" fill="#E8A54B"></circle><ellipse cx="15" cy="15" rx="14" ry="4.5" fill="none" stroke="#EDE6D8" stroke-width="2" transform="rotate(-20 15 15)"></ellipse></svg>
			{t('site.name')}
		</a>
		<nav class="nav">
			{links.map((link) => <a href={link.href} class:list={{ on: link.on }}>{link.label}</a>)}
		</nav>
	</div>
</header>
