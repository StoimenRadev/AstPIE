---
import Logo from './Logo.astro';
import { t } from '../i18n/t';

const path = Astro.url.pathname;
const inLearn = path.startsWith('/learn');
const inExplore = path.startsWith('/explore');

// The three parts of Explore, shown in the menu under "Explore"
const parts = [
	{ href: '/explore/missions', title: t('nav.missions'), text: t('nav.missionsText'), colour: 'var(--orange)' },
	{ href: '/explore/mysteries', title: t('nav.mysteries'), text: t('nav.mysteriesText'), colour: 'var(--navy)' },
	{ href: '/explore/catalogue', title: t('nav.catalogue'), text: t('nav.catalogueText'), colour: 'var(--yellow)' }
];
---

<header class="head">
	<div class="wrap">
		<a class="logo" href="/"><Logo />{t('site.name')}</a>
		<span class="brand-full">{t('site.fullName')}</span>
		<nav class="nav">
			<a class:list={['nav-link', { on: inLearn }]} href="/learn">{t('nav.learn')}</a>
			<div class="dd">
				<a class:list={['nav-link', { on: inExplore }]} href="/explore">{t('nav.explore')} <svg><use href="#i-chev" /></svg></a>
				<div class="dd-panel">
					{parts.map((part) => (
						<a href={part.href} style={'--c:' + part.colour}><i></i><div><b>{part.title}</b><span>{part.text}</span></div></a>
					))}
				</div>
			</div>
		</nav>
	</div>
</header>
