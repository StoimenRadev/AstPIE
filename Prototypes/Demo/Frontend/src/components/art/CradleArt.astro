---
// Newton's cradle, the picture of the Classical mechanics branch.
// Pivots on the bar at y=66, strings 204 px, balls r=30 resting at y=270.
// The left ball is lifted by 28 degrees; the dashed ring shows where the right ball will swing to.
---

<svg viewBox="0 0 600 380" role="img" aria-label="Newton's cradle: one ball lifted, about to swing">
	<defs>
		<clipPath id="nc-b1"><circle cx="84.2" cy="246.1" r="30"/></clipPath>
		<clipPath id="nc-b2"><circle cx="240" cy="270" r="30"/></clipPath>
		<clipPath id="nc-b3"><circle cx="300" cy="270" r="30"/></clipPath>
		<clipPath id="nc-b4"><circle cx="360" cy="270" r="30"/></clipPath>
		<clipPath id="nc-b5"><circle cx="420" cy="270" r="30"/></clipPath>
	</defs>
	<rect width="600" height="380" fill="#F7F9FE"/>
	<!-- frame -->
	<rect x="20" y="332" width="560" height="22" rx="7" fill="#1F2A44"/>
	<rect x="24" y="54" width="12" height="280" rx="4" fill="#1F2A44"/>
	<rect x="564" y="54" width="12" height="280" rx="4" fill="#1F2A44"/>
	<rect x="24" y="54" width="552" height="12" rx="6" fill="#1F2A44"/>
	<!-- path of the lifted ball and the ball it will push -->
	<path d="M180 270 A204 204 0 0 1 84.2 246.1" fill="none" stroke="#EE8636" stroke-width="3" stroke-dasharray="2 9" stroke-linecap="round"/>
	<path d="M420 270 A204 204 0 0 0 515.8 246.1" fill="none" stroke="#3F78D8" stroke-width="3" stroke-dasharray="2 9" stroke-linecap="round" opacity=".6"/>
	<circle cx="515.8" cy="246.1" r="30" fill="none" stroke="#3F78D8" stroke-width="2.5" stroke-dasharray="5 6" opacity=".6"/>
	<!-- strings -->
	<g stroke="#1F2A44" stroke-width="2">
		<path d="M180 66 L84.2 246.1"/>
		<path d="M240 66 V270 M300 66 V270 M360 66 V270 M420 66 V270"/>
	</g>
	<!-- shadows -->
	<g fill="#1F2A44" opacity=".1"><ellipse cx="96" cy="330" rx="26" ry="4"/><ellipse cx="240" cy="330" rx="28" ry="4.5"/><ellipse cx="300" cy="330" rx="28" ry="4.5"/><ellipse cx="360" cy="330" rx="28" ry="4.5"/><ellipse cx="420" cy="330" rx="28" ry="4.5"/></g>
	<!-- balls -->
	<g clip-path="url(#nc-b1)"><circle cx="84.2" cy="246.1" r="30" fill="#EE8636"/><circle cx="96" cy="258" r="30" fill="#B85A14" opacity=".45"/></g>
	<g clip-path="url(#nc-b2)"><circle cx="240" cy="270" r="30" fill="#3F78D8"/><circle cx="252" cy="282" r="30" fill="#1F2A44" opacity=".4"/></g>
	<g clip-path="url(#nc-b3)"><circle cx="300" cy="270" r="30" fill="#3F78D8"/><circle cx="312" cy="282" r="30" fill="#1F2A44" opacity=".4"/></g>
	<g clip-path="url(#nc-b4)"><circle cx="360" cy="270" r="30" fill="#3F78D8"/><circle cx="372" cy="282" r="30" fill="#1F2A44" opacity=".4"/></g>
	<g clip-path="url(#nc-b5)"><circle cx="420" cy="270" r="30" fill="#3F78D8"/><circle cx="432" cy="282" r="30" fill="#1F2A44" opacity=".4"/></g>
	<g fill="#fff" opacity=".7"><circle cx="74" cy="236" r="7"/><circle cx="230" cy="260" r="7"/><circle cx="290" cy="260" r="7"/><circle cx="350" cy="260" r="7"/><circle cx="410" cy="260" r="7"/></g>
	<g fill="#1F2A44"><circle cx="180" cy="66" r="4"/><circle cx="240" cy="66" r="4"/><circle cx="300" cy="66" r="4"/><circle cx="360" cy="66" r="4"/><circle cx="420" cy="66" r="4"/></g>
</svg>
