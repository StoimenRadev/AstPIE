---
// The home page picture, drawn behind the title. The left part is open sky,
// so the heading and the buttons never sit on top of a drawing.
// Geometry (viewBox 1600 x 760):
//   the Earth is a circle at (1250, 1250) with r = 700; its top is at y = 550
//   the orbit is the same centre with r = 860; its top is at (1250, 390)
//   the rocket climbs on its own path, from the pad (1000, 596) straight up and then
//   leaning right, high above the orbit; solid behind it, dashed where it is heading.
//   At the rocket (1090, 210) the path points along (70, -80), so the rocket is turned 41.2 degrees.

function seeded(seed: number)
{
	let s = seed;
	return () =>
	{
		s = (s * 16807) % 2147483647;
		return (s - 1) / 2147483646;
	};
}

interface Star
{
	x: number;
	y: number;
	r: number;
	o: number;
}

const next = seeded(4241);
const stars: Star[] = [];
while (stars.length < 210)
{
	const x = next() * 1600;
	const y = next() * 760;
	// No stars on the Earth
	const dx = x - 1250;
	const dy = y - 1250;
	if (Math.sqrt(dx * dx + dy * dy) < 730)
	{
		continue;
	}
	let r = 0.8 + next() * 0.9;
	if (next() > 0.94)
	{
		r = 2.2;
	}
	stars.push({ x: Math.round(x), y: Math.round(y), r: Number(r.toFixed(1)), o: Number((0.3 + next() * 0.6).toFixed(2)) });
}

// Four-pointed sparkles: away from the text on the left
const sparkles = [
	{ x: 70, y: 70, s: 0.7, c: '#EE8636' },
	{ x: 820, y: 90, s: 0.8, c: '#F2C14E' },
	{ x: 1260, y: 250, s: 0.5, c: '#FFFFFF' },
	{ x: 1560, y: 300, s: 0.55, c: '#8FB0EC' },
	{ x: 120, y: 690, s: 0.5, c: '#FFFFFF' }
];
---

<svg viewBox="0 0 1600 760" preserveAspectRatio="xMaxYMax slice" aria-hidden="true">
	<defs>
		<clipPath id="ha-earth"><circle cx="1250" cy="1250" r="700" /></clipPath>
		<clipPath id="ha-moon"><circle cx="1440" cy="130" r="46" /></clipPath>
		<clipPath id="ha-planet"><circle cx="960" cy="140" r="20" /></clipPath>
		<path id="ha-spark" d="M0 -20 C2 -5 5 -2 20 0 C5 2 2 5 0 20 C-2 5 -5 2 -20 0 C-5 -2 -2 -5 0 -20Z" />
	</defs>

	<rect width="1600" height="760" fill="#1F2A44" />
	<circle cx="260" cy="120" r="420" fill="#222E4B" />
	<circle cx="1420" cy="90" r="300" fill="#23304E" />
	<g>{stars.map((s) => <circle cx={s.x} cy={s.y} r={s.r} fill="#fff" opacity={s.o} />)}</g>
	{sparkles.map((p) => (
		<g transform={'translate(' + p.x + ' ' + p.y + ')'}>
			<circle r={22 * p.s} fill={p.c} opacity="0.16" />
			<use href="#ha-spark" transform={'scale(' + p.s + ')'} fill={p.c} />
		</g>
	))}

	<!-- a far planet -->
	<g clip-path="url(#ha-planet)">
		<circle cx="960" cy="140" r="20" fill="#EE8636" />
		<rect x="938" y="133" width="44" height="4" fill="#F2C14E" opacity="0.7" />
		<circle cx="969" cy="149" r="20" fill="#1F2A44" opacity="0.4" />
	</g>

	<!-- the Moon -->
	<g clip-path="url(#ha-moon)">
		<circle cx="1440" cy="130" r="46" fill="#E6E9F0" />
		<circle cx="1458" cy="146" r="46" fill="#A9B5CC" opacity="0.6" />
		<circle cx="1424" cy="116" r="9" fill="#C9D1E0" />
		<circle cx="1450" cy="148" r="6" fill="#C9D1E0" />
		<circle cx="1420" cy="148" r="4.5" fill="#C9D1E0" />
	</g>

	<!-- the Earth: atmosphere, ocean, land, clouds, night side -->
	<circle cx="1250" cy="1250" r="732" fill="#8FB0EC" opacity="0.13" />
	<circle cx="1250" cy="1250" r="715" fill="#8FB0EC" opacity="0.25" />
	<g clip-path="url(#ha-earth)">
		<circle cx="1250" cy="1250" r="700" fill="#2F66CF" />
		<circle cx="1222" cy="1226" r="700" fill="#3F78D8" />
		<path d="M820 690 C870 650 950 640 1010 658 C1070 676 1090 720 1060 770 L820 770Z" fill="#3BA56B" />
		<path d="M900 690 C930 680 965 684 978 700 C956 714 920 714 900 706Z" fill="#E2B861" />
		<path d="M1130 598 C1180 568 1270 560 1340 574 C1410 588 1430 620 1396 644 C1352 668 1286 652 1240 664 C1196 676 1146 660 1132 638Z" fill="#3BA56B" />
		<path d="M1200 600 C1232 590 1278 594 1292 612 C1270 626 1226 626 1200 616Z" fill="#E2B861" />
		<path d="M1300 640 C1322 634 1346 638 1356 650 C1340 660 1316 660 1302 654Z" fill="#2E8C5A" />
		<path d="M1460 680 C1500 650 1560 640 1620 650 L1620 770 L1460 770Z" fill="#3BA56B" />
		<rect x="1040" y="610" width="180" height="16" rx="8" fill="#fff" opacity="0.88" />
		<rect x="1130" y="634" width="104" height="12" rx="6" fill="#fff" opacity="0.72" />
		<rect x="1380" y="660" width="160" height="14" rx="7" fill="#fff" opacity="0.82" />
		<rect x="860" y="720" width="130" height="12" rx="6" fill="#fff" opacity="0.7" />
		<circle cx="1700" cy="1400" r="700" fill="#0B1A4A" opacity="0.42" />
		<g fill="#FFD36B">
			<circle cx="1540" cy="706" r="2.6" /><circle cx="1562" cy="722" r="2" /><circle cx="1584" cy="700" r="2.6" />
			<circle cx="1570" cy="742" r="2.2" /><circle cx="1520" cy="740" r="2" />
		</g>
	</g>
	<circle cx="1250" cy="1250" r="700" fill="none" stroke="#B8CEF4" stroke-opacity="0.5" stroke-width="4" />

	<!-- the orbit -->
	<path d="M800 517 A860 860 0 0 1 1600 464.4" fill="none" stroke="#fff" stroke-opacity="0.16" stroke-width="2" stroke-dasharray="3 10" stroke-linecap="round" />

	<!-- launch pad, standing straight up from the curved ground -->
	<g transform="rotate(-20.9 1000 596)" fill="#E6E9F0">
		<rect x="984" y="586" width="32" height="12" rx="2" />
		<rect x="1010" y="550" width="5" height="40" />
		<rect x="999" y="558" width="13" height="3" />
	</g>

	<!-- the path: flown (solid, with exhaust) and ahead (dashed) -->
	<path d="M1000 596 C975 470 1020 290 1090 210" fill="none" stroke="#fff" stroke-width="16" stroke-opacity="0.12" stroke-linecap="round" />
	<path d="M1000 596 C975 470 1020 290 1090 210" fill="none" stroke="#fff" stroke-width="3" stroke-linecap="round" />
	<path d="M1090 210 C1130 164 1180 128 1250 100" fill="none" stroke="#fff" stroke-width="3" stroke-dasharray="2 11" stroke-linecap="round" opacity="0.85" />

	<!-- a satellite already in that orbit -->
	<g transform="translate(1420 407) rotate(11.4)">
		<rect x="-36" y="-5" width="25" height="10" rx="1.5" fill="#3F78D8" />
		<rect x="11" y="-5" width="25" height="10" rx="1.5" fill="#3F78D8" />
		<path d="M-23.5 -5 V5 M23.5 -5 V5" stroke="#1F2A44" stroke-width="1.2" />
		<rect x="-11" y="-1.2" width="22" height="2.4" fill="#C9D1E0" />
		<rect x="-8" y="-8" width="16" height="16" rx="3" fill="#F2C14E" />
		<rect x="0" y="-8" width="8" height="16" rx="2" fill="#D9A633" />
	</g>

	<!-- the rocket: one body, pointing along its path -->
	<g transform="translate(1090 210) rotate(41.2) scale(2.3)">
		<path d="M-6 18 Q0 44 6 18Z" fill="#F2C14E" />
		<path d="M-3 18 Q0 32 3 18Z" fill="#fff" />
		<path d="M-8 8 L-15 20 L-8 18Z M8 8 L15 20 L8 18Z" fill="#EE8636" />
		<path d="M-8 18 V-8 Q0 -34 8 -8 V18Z" fill="#F5F6F9" />
		<path d="M0 -27 Q6 -18 8 -8 V18 H0Z" fill="#C9D1E0" />
		<path d="M-8 -8 Q0 -34 8 -8Z" fill="#EE8636" />
		<circle cx="0" cy="0" r="3.5" fill="#1F2A44" />
	</g>
</svg>
