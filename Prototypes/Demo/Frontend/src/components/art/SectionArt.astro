---
// One small drawing per Explore section (not per item), so new missions,
// mysteries and objects never need their own art.
//   missions:  a path from the ground into orbit, with dots for the parts of the story
//   mysteries: six strong bars (the Wow! signal) circled among the noise
//   catalogue: a star chart with one star marked
interface Props
{
	name: 'missions' | 'mysteries' | 'catalogue';
}

const { name } = Astro.props;

function seeded(seed: number)
{
	let s = seed;
	return () =>
	{
		s = (s * 16807) % 2147483647;
		return (s - 1) / 2147483646;
	};
}

// Mysteries: low noise bars, and the six signal bars in the middle
const noiseRandom = seeded(11);
const noise = [];
for (let x = 14; x < 312; x += 14)
{
	if (x >= 96 && x <= 204)
	{
		continue;
	}
	const h = 5 + noiseRandom() * 10;
	noise.push({ x: x, y: 160 - h, h: h });
}
// The strongest bar is orange, the others light
const signal = [6, 14, 26, 30, 19, 5].map((value, i) =>
{
	let colour = '#E6E9F0';
	if (value === 30)
	{
		colour = '#EE8636';
	}
	return { x: 105 + i * 18, h: value * 3.6, colour: colour };
});

// Catalogue: scattered stars, keeping space free around the marked one
const starRandom = seeded(5);
const stars = [];
while (stars.length < 30)
{
	const x = 12 + starRandom() * 296;
	const y = 12 + starRandom() * 176;
	if (Math.abs(x - 214) < 26 && Math.abs(y - 86) < 26)
	{
		continue;
	}
	const sizes = [1.2, 1.2, 1.8, 1.8, 2.6];
	stars.push({ x: Math.round(x), y: Math.round(y), r: sizes[Math.floor(starRandom() * 5)], o: [0.45, 0.7, 0.9][Math.floor(starRandom() * 3)] });
}
---

{name === 'missions' && (
	<svg viewBox="0 0 320 200" aria-hidden="true">
		<rect width="320" height="200" fill="#FCECDE" />
		<circle cx="160" cy="520" r="380" fill="#1F2A44" />
		<path d="M60 153.4 C63 112 105 66 160 64 A456 456 0 0 1 300 86" fill="none" stroke="#EE8636" stroke-width="4" stroke-linecap="round" />
		<g stroke="#1F2A44" stroke-width="3">
			<circle cx="74.8" cy="112.7" r="7" fill="#EE8636" />
			<circle cx="114.7" cy="76.4" r="7" fill="#EE8636" />
			<circle cx="160" cy="64" r="7" fill="#EE8636" />
			<circle cx="240" cy="71.1" r="7" fill="#FCECDE" />
		</g>
		<g transform="translate(296 85) rotate(107.9)">
			<path d="M-5 14 Q0 30 5 14Z" fill="#F2C14E" />
			<path d="M-6 14 V-6 Q0 -24 6 -6 V14Z" fill="#1F2A44" />
			<path d="M-6 -6 Q0 -24 6 -6Z" fill="#EE8636" />
		</g>
	</svg>
)}

{name === 'mysteries' && (
	<svg viewBox="0 0 320 200" aria-hidden="true">
		<rect width="320" height="200" fill="#1F2A44" />
		{noise.map((b) => <rect x={b.x} y={b.y.toFixed(1)} width="8" height={b.h.toFixed(1)} rx="2" fill="#3A4C72" />)}
		{signal.map((b) => <rect x={b.x} y={(160 - b.h).toFixed(1)} width="12" height={b.h.toFixed(1)} rx="2.5" fill={b.colour} />)}
		<rect x="14" y="160" width="292" height="3" rx="1.5" fill="#E6E9F0" />
		<ellipse cx="158" cy="112" rx="70" ry="62" fill="none" stroke="#EE8636" stroke-width="3" transform="rotate(-6 158 112)" />
	</svg>
)}

{name === 'catalogue' && (
	<svg viewBox="0 0 320 200" aria-hidden="true">
		<rect width="320" height="200" fill="#FBF3D9" />
		<g fill="none" stroke="#E8D49A" stroke-width="1.5">
			<path d="M-20 60 Q160 20 340 60 M-20 120 Q160 80 340 120 M-20 180 Q160 140 340 180" />
			<path d="M70 -10 Q50 100 70 210 M160 -10 V210 M250 -10 Q270 100 250 210" />
		</g>
		<path d="M52 150 L96 118 L132 132 L170 96 L214 86" fill="none" stroke="#1F2A44" stroke-width="1.5" opacity="0.35" />
		{stars.map((s) => <circle cx={s.x} cy={s.y} r={s.r} fill="#1F2A44" opacity={s.o} />)}
		<g fill="#1F2A44"><circle cx="52" cy="150" r="3" /><circle cx="96" cy="118" r="2.6" /><circle cx="132" cy="132" r="3.2" /><circle cx="170" cy="96" r="2.4" /></g>
		<circle cx="214" cy="86" r="5" fill="#1F2A44" />
		<circle cx="214" cy="86" r="17" fill="none" stroke="#8C6508" stroke-width="2.5" />
		<path d="M214 60 V64 M214 108 V112 M188 86 H192 M236 86 H240" stroke="#8C6508" stroke-width="2.5" stroke-linecap="round" />
	</svg>
)}
