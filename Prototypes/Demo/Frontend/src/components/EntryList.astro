---
// Missions or mysteries as cards; the first one is shown wide
import Photo from './Photo.astro';
import { t } from '../i18n/t';
import type { EntryListItem } from '../lib/api';
import { formatYears, outcomeLabel, statusLabel } from '../lib/format';
import { countryOf } from '../lib/scenes';

interface Props
{
	entries: EntryListItem[];
	// For example "/explore/missions"
	basePath: string;
	// The drawing shown when an entry has no cover photo
	scene: string;
	// The text on the wide card's link
	more: string;
}

const { entries, basePath, scene, more } = Astro.props;

function countryColour(country: string): string
{
	if (country === 'ussr')
	{
		return 'var(--ussr)';
	}
	if (country === 'usa')
	{
		return 'var(--usa)';
	}
	return 'var(--accent)';
}

const cards = entries.map((entry, index) =>
{
	let status = '';
	if (entry.missionOutcome !== null)
	{
		status = outcomeLabel(entry.missionOutcome);
	}
	if (entry.evidenceStatus !== null)
	{
		status = statusLabel(entry.evidenceStatus);
	}
	const country = countryOf(entry.agency);
	let who = '';
	if (entry.agency !== null)
	{
		who = entry.agency;
	}
	return {
		entry: entry,
		feature: index === 0,
		status: status,
		country: country,
		colour: countryColour(country),
		who: who,
		years: formatYears(entry.startDate, entry.endDate, entry.missionOutcome === 'Ongoing')
	};
});
---

<div class="cards" data-cards>
	{cards.map((card) => (
		<a class:list={['card', { feature: card.feature }]} href={basePath + '/' + card.entry.slug} data-country={card.country}>
			<Photo src={card.entry.coverImageUrl} scene={scene} className="" />
			<div>
				<div class="meta">
					{card.who !== '' && <span><span class="dot" style={'background:' + card.colour}></span>{card.who}</span>}
					{card.years !== '' && <span>{card.years}</span>}
					{card.status !== '' && <span class="status">{card.status}</span>}
				</div>
				<h3>{card.entry.title}</h3>
				<p>{card.entry.summary}</p>
				{card.feature && <span class="more" style="margin-top:18px">{more} →</span>}
			</div>
		</a>
	))}
</div>
