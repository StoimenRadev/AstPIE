---
// Learn: a pulsar, its two beams sweeping round
---

<svg aria-hidden="true" viewBox="0 0 760 760">
				<defs>
					<linearGradient id="pb" x1="0" x2="1"><stop offset="0" stop-color="#cdeeea"/><stop offset="1" stop-color="#cdeeea" stop-opacity="0"/></linearGradient>
					<linearGradient id="pb2" x1="0" x2="1"><stop offset="0" stop-color="#8fd0cf"/><stop offset="1" stop-color="#8fd0cf" stop-opacity="0"/></linearGradient>
				</defs>
				<circle class="ripple" cx="380" cy="380" r="350" fill="none" stroke="#8fd0cf" stroke-width="3"/>
				<circle class="ripple r2" cx="380" cy="380" r="350" fill="none" stroke="#8fd0cf" stroke-width="3"/>
				<g class="slowspin"><circle cx="380" cy="380" r="150" fill="none" stroke="#8fd0cf" stroke-width="2" stroke-dasharray="4 14" opacity=".7"/><circle cx="380" cy="380" r="210" fill="none" stroke="#5aa3a6" stroke-width="2" stroke-dasharray="30 18 4 18" opacity=".5"/></g>
				<g class="beams">
					<g>
						<path d="M380 380 L760 290 L760 470 Z" fill="url(#pb2)" opacity=".22"/>
						<path d="M380 380 L760 330 L760 430 Z" fill="url(#pb2)" opacity=".38"/>
						<path d="M380 380 L760 362 L760 398 Z" fill="url(#pb)" opacity=".85"/>
						<path d="M410 380 L740 380" stroke="#ffffff" stroke-width="2" stroke-dasharray="26 16" opacity=".6"/>
					</g>
					<g transform="rotate(180 380 380)">
						<path d="M380 380 L760 290 L760 470 Z" fill="url(#pb2)" opacity=".22"/>
						<path d="M380 380 L760 330 L760 430 Z" fill="url(#pb2)" opacity=".38"/>
						<path d="M380 380 L760 362 L760 398 Z" fill="url(#pb)" opacity=".85"/>
						<path d="M410 380 L740 380" stroke="#ffffff" stroke-width="2" stroke-dasharray="26 16" opacity=".6"/>
					</g>
				</g>
				<circle cx="380" cy="380" r="86" fill="#8fd0cf" opacity=".12"/>
				<circle cx="380" cy="380" r="60" fill="#8fd0cf" opacity=".22"/>
				<circle cx="380" cy="380" r="38" fill="#a9dcd8" opacity=".55"/>
				<circle cx="380" cy="380" r="24" fill="#e2f4f1"/>
				<circle cx="380" cy="380" r="13" fill="#ffffff"/>
			</svg>
