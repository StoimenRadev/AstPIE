---
// One of the section drawings from SceneDefs, filling its box
interface Props
{
	// For example "scene-missions" or "law-1"
	name: string;
	// The class of the <svg>; "fallback" when it sits behind a photo
	className: string;
}

const { name, className } = Astro.props;
---

<svg class={className} viewBox="0 0 1600 900" preserveAspectRatio="xMidYMid slice" aria-hidden="true"><use href={'#' + name} width="1600" height="900"></use></svg>
