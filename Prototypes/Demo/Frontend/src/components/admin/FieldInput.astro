---
// One field of an admin form, drawn according to its type
import type { FieldConfig } from '../../lib/admin/config';
import type { Choice } from '../../lib/admin/forms';

interface Props
{
	field: FieldConfig;
	value: unknown;
	error: string;
	choices: Choice[];
	// true when editing a row whose field can't change any more
	locked: boolean;
}

const { field, value, error, choices, locked } = Astro.props;

let text = '';
if (value !== null && value !== undefined)
{
	text = String(value);
}

let lockedLabel = text;
if (locked && field.type === 'ref')
{
	const choice = choices.find((c) => c.id === text);
	if (choice !== undefined)
	{
		lockedLabel = choice.label;
	}
}

const id = 'field-' + field.name;
let rows = 3;
if (field.type === 'markdown')
{
	rows = 14;
}
---

<div class:list={['field', { 'has-error': error !== '' }]}>
	{field.type === 'checkbox' && (
		<label class="checkbox">
			<input type="checkbox" name={field.name} checked={value === true} />
			{field.label}
		</label>
	)}

	{field.type !== 'checkbox' && (
		<label for={id}>
			{field.label}
			{field.required && <span class="required">*</span>}
		</label>
	)}

	{locked && (
		<>
			<p class="locked">{lockedLabel}</p>
			<input type="hidden" name={field.name} value={text} />
		</>
	)}

	{!locked && (field.type === 'text' || field.type === 'file') && (
		<input id={id} type="text" name={field.name} value={text} />
	)}

	{!locked && (field.type === 'textarea' || field.type === 'markdown') && (
		<textarea id={id} name={field.name} rows={rows} class:list={{ markdown: field.type === 'markdown' }}>{text}</textarea>
	)}

	{!locked && (field.type === 'int' || field.type === 'number') && (
		<input id={id} type="text" inputmode="decimal" name={field.name} value={text} />
	)}

	{!locked && field.type === 'date' && (
		<input id={id} type="date" name={field.name} value={text} />
	)}

	{!locked && field.type === 'select' && (
		<select id={id} name={field.name}>
			{!field.required && <option value="">—</option>}
			{field.options.map((option) => (
				<option value={option} selected={option === text}>{option}</option>
			))}
		</select>
	)}

	{!locked && field.type === 'ref' && (
		<select id={id} name={field.name}>
			<option value="">—</option>
			{choices.map((choice) => (
				<option value={choice.id} selected={choice.id === text}>{choice.label}</option>
			))}
		</select>
	)}

	{!locked && field.type === 'file' && (
		<div class="file">
			<input type="file" name={field.name + '__file'} accept="image/*,audio/*,video/*" />
			{text !== '' && <a href={text} target="_blank">Open the current file</a>}
		</div>
	)}

	{field.help !== '' && <p class="help">{field.help}</p>}
	{error !== '' && <p class="error">{error}</p>}
</div>

<style>
	.field {
		display: flex;
		flex-direction: column;
		gap: var(--space-1);
		margin-bottom: var(--space-3);
	}

	label {
		font-weight: 600;
	}

	.checkbox {
		display: flex;
		align-items: center;
		gap: var(--space-2);
	}

	.required {
		margin-left: 0.25rem;
		color: #b91c1c;
	}

	input[type='text'],
	input[type='date'],
	select,
	textarea {
		width: 100%;
		max-width: 40rem;
		padding: var(--space-2);
		border: 1px solid var(--color-border);
		border-radius: 0.375rem;
		background: var(--color-bg);
		color: var(--color-text);
		font: inherit;
	}

	textarea.markdown {
		max-width: 56rem;
		font-family: ui-monospace, Consolas, monospace;
		font-size: 0.875rem;
	}

	.file {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: var(--space-3);
	}

	.locked {
		margin: 0;
	}

	.help {
		margin: 0;
		color: var(--color-muted);
		font-size: 0.8125rem;
	}

	.error {
		margin: 0;
		color: #b91c1c;
		font-size: 0.875rem;
	}

	.has-error input,
	.has-error select,
	.has-error textarea {
		border-color: #b91c1c;
	}
</style>
