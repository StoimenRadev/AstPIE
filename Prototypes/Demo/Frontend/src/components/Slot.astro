---
// A place for a picture. With no picture (or when it fails to load) it shows
// an empty box with a short text, so the page keeps its shape.
interface Props
{
	// Empty when there is no picture yet
	src: string;
	// For example "4 / 3" or "1 / 1"
	ratio: string;
	// Shown in the empty box, for example the initials of a person
	empty: string;
	// Extra classes, for example "fit" to show the whole picture
	className: string;
}

const { src, ratio, empty, className } = Astro.props;

let classes = 'slot ' + className;
if (src === '')
{
	classes = classes + ' empty';
}
---

<div class={classes} style={'--ratio:' + ratio} data-empty={empty}>
	{src !== '' && <img src={src} alt="" loading="lazy" />}
	<slot />
</div>
