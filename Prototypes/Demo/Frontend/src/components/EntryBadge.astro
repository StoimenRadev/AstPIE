---
// The result of a mission or the status of a mystery, as a small coloured label
import { outcomeLabel, statusLabel } from '../lib/format';

interface Props
{
	missionOutcome: string | null;
	evidenceStatus: string | null;
}

const { missionOutcome, evidenceStatus } = Astro.props;

let text = '';
let value = '';
if (missionOutcome !== null)
{
	text = outcomeLabel(missionOutcome);
	value = missionOutcome;
}
else if (evidenceStatus !== null)
{
	text = statusLabel(evidenceStatus);
	value = evidenceStatus;
}
---

{text !== '' && <span class={'badge badge-' + value}>{text}</span>}

<style>
	.badge {
		display: inline-block;
		padding: 0.125rem 0.5rem;
		border-radius: 999px;
		font-size: 0.8125rem;
		font-weight: 600;
		background: var(--color-surface);
		color: var(--color-text);
	}

	/* Placeholder colours until the design pass */
	.badge-Success {
		background: #dcfce7;
		color: #166534;
	}

	.badge-PartialSuccess,
	.badge-UnderInvestigation {
		background: #fef3c7;
		color: #92400e;
	}

	.badge-Failure {
		background: #fee2e2;
		color: #991b1b;
	}

	.badge-Ongoing,
	.badge-Hypothesis {
		background: #dbeafe;
		color: #1e40af;
	}

	.badge-Unexplained {
		background: #ede9fe;
		color: #5b21b6;
	}

	.badge-Debunked {
		background: #e4e4e7;
		color: #3f3f46;
	}
</style>
