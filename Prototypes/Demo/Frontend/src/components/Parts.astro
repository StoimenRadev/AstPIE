---
// The text of one chapter. Widgets named in the text with [[name]] are put in their place.
import SimulationPlayer from './SimulationPlayer';
import SputnikRadio from './widgets/SputnikRadio.astro';
import SignalDecoder from './widgets/SignalDecoder.astro';
import { simulationLabels } from '../i18n/simulationLabels';
import type { Simulation } from '../lib/api';
import type { ChapterPart } from '../lib/chapters';

interface Props
{
	parts: ChapterPart[];
	// Shown where the text says [[simulation]]; empty when the page has none
	simulations: Simulation[];
}

const { parts, simulations } = Astro.props;
const labels = simulationLabels();

// Text that already has its own blocks is used as it is; plain text goes in a .read block
const LAID_OUT = /class="(read|wide|pull)[ "]/;
---

{parts.map((part) => (
	<>
		{part.kind === 'html' && LAID_OUT.test(part.html) && <Fragment set:html={part.html} />}
		{part.kind === 'html' && !LAID_OUT.test(part.html) && <div class="read" set:html={part.html} />}
		{part.kind === 'radio' && <div class="wide"><SputnikRadio /></div>}
		{part.kind === 'decoder' && <div class="wide"><SignalDecoder /></div>}
		{part.kind === 'simulation' && (
			<div class="wide">
				{simulations.map((simulation) => (
					<SimulationPlayer
						client:load
						title={simulation.title}
						learningGoal={simulation.learningGoal}
						buildUrl={simulation.buildUrl}
						thumbnailUrl={simulation.thumbnailUrl}
						labels={labels}
					/>
				))}
			</div>
		)}
	</>
))}
