---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Icons from '../components/Icons.astro';
import { t } from '../i18n/t';
import '../styles/global.css';

interface Props
{
	title: string;
	// The accent of the section: home, learn, missions, mysteries or catalogue
	theme: string;
	// Extra class on <body>, for example "has-after" when a grey block ends the page
	bodyClass: string;
}

const { title, theme, bodyClass } = Astro.props;

let pageTitle = t('site.name');
if (title !== t('site.name'))
{
	pageTitle = title + ' | ' + t('site.name');
}
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link href="https://fonts.googleapis.com/css2?family=Jost:wght@400;500;600;700&family=Literata:ital,opsz,wght@0,7..72,400;0,7..72,500;0,7..72,600;1,7..72,400&display=swap" rel="stylesheet" />
		<title>{pageTitle}</title>
		<!-- Pages can add their own tags here, for example a description: <meta slot="head" ... /> -->
		<slot name="head" />
	</head>
	<body data-theme={theme} class={bodyClass}>
		<Icons />
		<Header />
		<main>
			<slot />
		</main>
		<Footer />
	</body>
</html>

<script>
	// Pictures written inside the stored texts: <div class="photo" data-img="File name.jpg">.
	// A file name is loaded from Wikimedia Commons; a full address is used as it is.
	const archive = 'https://commons.wikimedia.org/wiki/Special:FilePath/';
	for (const box of document.querySelectorAll<HTMLElement>('.photo[data-img]'))
	{
		if (box.querySelector('img') !== null)
		{
			continue;
		}
		let src = String(box.dataset.img);
		if (!src.startsWith('http') && !src.startsWith('/'))
		{
			src = archive + src + '?width=1600';
		}
		const img = document.createElement('img');
		img.alt = '';
		img.loading = 'lazy';
		img.src = src;
		img.addEventListener('error', () => box.classList.add('missing'));
		box.appendChild(img);
	}

	// Image slots made by Slot.astro: when the picture fails, show the empty slot
	function showEmpty(img: HTMLImageElement)
	{
		const slot = img.parentElement;
		if (slot !== null)
		{
			slot.classList.add('empty');
		}
		img.remove();
	}
	for (const img of document.querySelectorAll<HTMLImageElement>('.slot > img'))
	{
		// It may have failed before this script ran
		if (img.complete && img.naturalWidth === 0)
		{
			showEmpty(img);
		}
		else
		{
			img.addEventListener('error', () => showEmpty(img));
		}
	}
</script>
