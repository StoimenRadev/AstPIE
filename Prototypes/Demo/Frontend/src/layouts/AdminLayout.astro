---
// Layout of the admin pages: not in the site menu, and search engines are told to skip it
import { TABLES } from '../lib/admin/config';
import '../styles/global.css';

interface Props
{
	title: string;
	// false on the login page
	showMenu: boolean;
}

const { title, showMenu } = Astro.props;
const path = Astro.url.pathname;
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="robots" content="noindex, nofollow" />
		<title>{title + ' | AstPIE admin'}</title>
	</head>
	<body class="admin" data-theme="home">
		<header class="admin-header">
			<div class="container bar">
				<a class="logo" href="/admin">AstPIE admin</a>
				{showMenu && (
					<form method="post" action="/admin/logout">
						<a href="/" target="_blank">View site</a>
						<button type="submit">Log out</button>
					</form>
				)}
			</div>
		</header>

		<div class="container layout">
			{showMenu && (
				<nav class="menu">
					{TABLES.map((table) => (
						<a href={'/admin/' + table.key} class:list={{ active: path.startsWith('/admin/' + table.key) }}>{table.title}</a>
					))}
				</nav>
			)}
			<main>
				<slot />
			</main>
		</div>
	</body>
</html>

<style>
	.admin-header {
		background: var(--bg-2);
		color: var(--text);
		box-shadow: 0 1px 0 var(--line);
	}

	.bar {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: var(--space-3);
		padding-top: var(--space-3);
		padding-bottom: var(--space-3);
	}

	.admin-header a {
		color: var(--text);
	}

	.logo {
		font-weight: 700;
		text-decoration: none;
	}

	.admin-header form {
		display: flex;
		align-items: center;
		gap: var(--space-3);
	}

	.admin-header button {
		padding: var(--space-1) var(--space-3);
		border: 1px solid var(--text);
		border-radius: 0.375rem;
		background: transparent;
		color: var(--text);
		font: inherit;
		cursor: pointer;
	}

	.layout {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-5);
		padding-top: var(--space-4);
		padding-bottom: var(--space-5);
	}

	.menu {
		display: flex;
		flex-direction: column;
		gap: var(--space-1);
		min-width: 11rem;
	}

	.menu a {
		padding: var(--space-1) var(--space-2);
		border-radius: 0.25rem;
		color: var(--color-text);
		text-decoration: none;
	}

	.menu a:hover,
	.menu a.active {
		background: var(--color-surface);
		font-weight: 600;
	}

	main {
		flex: 1;
		min-width: 0;
	}

	@media (max-width: 767px) {
		.menu {
			flex-direction: row;
			flex-wrap: wrap;
			min-width: 0;
		}
	}
</style>

<style is:global>
	/* The admin pages: one dark background from top to bottom, and form fields that match it */
	html:has(body.admin) { background: var(--bg); }
	body.admin { min-height: 100vh; background: var(--bg); color: var(--text); font-family: var(--head); line-height: 1.55; }
	body.admin a { color: var(--accent); }
	body.admin h1, body.admin h2 { font-family: var(--head); font-weight: 800; }
	body.admin input, body.admin select, body.admin textarea {
		background: var(--bg-2);
		color: var(--text);
		border: 1px solid var(--line);
		border-radius: 8px;
		padding: 8px 10px;
		font: inherit;
	}
	body.admin input:focus, body.admin select:focus, body.admin textarea:focus { outline: 2px solid var(--accent); outline-offset: 1px; }
	body.admin input[type="checkbox"] { width: auto; accent-color: var(--accent); }
	body.admin button, body.admin .button {
		background: var(--accent);
		color: var(--on-accent);
		border: 0;
		border-radius: 999px;
		padding: 9px 18px;
		font: 700 0.95rem var(--head);
		cursor: pointer;
		text-decoration: none;
	}
	body.admin .admin-header button { background: transparent; color: var(--text); border: 1px solid var(--line); }
	body.admin table { border-collapse: collapse; width: 100%; }
	body.admin th, body.admin td { border-bottom: 1px solid var(--line); padding: 10px 8px; text-align: left; }
	body.admin th { color: var(--soft); font-weight: 600; }
</style>
