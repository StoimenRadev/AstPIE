---
// Layout of the admin pages: not in the site menu, and search engines are told to skip it.
// The menu is grouped by what the tables are for.
import Logo from '../components/Logo.astro';
import { findTable } from '../lib/admin/config';
import '../styles/global.css';

interface Props
{
	title: string;
	// false on the login page
	showMenu: boolean;
}

const { title, showMenu } = Astro.props;
const path = Astro.url.pathname;

// Each group lists table keys from lib/admin/config.ts, with the colour of its section
const GROUPS = [
	{ title: 'Learn', colour: 'var(--blue)', keys: ['topics', 'simulations', 'key-words'] },
	{ title: 'Explore', colour: 'var(--orange)', keys: ['entries', 'chapters', 'media', 'explanations'] },
	{ title: 'Catalogue', colour: 'var(--yellow)', keys: ['catalogue', 'log-entries', 'instruments'] },
	{ title: 'Used by many pages', colour: '#C3CAD8', keys: ['people', 'entry-people'] }
];

const groups = GROUPS.map((group) =>
{
	const links = [];
	for (const key of group.keys)
	{
		const table = findTable(key);
		if (table !== null)
		{
			links.push({ href: '/admin/' + key, title: table.title, on: path.startsWith('/admin/' + key) });
		}
	}
	return { title: group.title, colour: group.colour, links: links };
});
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="robots" content="noindex, nofollow" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link href="https://fonts.googleapis.com/css2?family=Jost:wght@400;500;600;700&family=Literata:opsz,wght@7..72,400&display=swap" rel="stylesheet" />
		<title>{title + ' | AstPIE admin'}</title>
	</head>
	<body class="admin" data-theme="home">
		<div class:list={['adm', { solo: !showMenu }]}>
			{showMenu && (
				<aside class="a-side">
					<a class="logo" href="/admin"><Logo id="adminLogo" /><span>AstPIE</span> <em>Admin</em></a>
					<div class="a-grp"><a href="/admin" class:list={{ on: path === '/admin' || path === '/admin/' }}><i style="--c:var(--navy)"></i>Overview</a></div>
					{groups.map((group) => (
						<div class="a-grp">
							<h5>{group.title}</h5>
							{group.links.map((link) => <a href={link.href} class:list={{ on: link.on }}><i style={'--c:' + group.colour}></i>{link.title}</a>)}
						</div>
					))}
					<div class="a-grp bottom">
						<a href="/" target="_blank">View the site</a>
						<form method="post" action="/admin/logout"><button type="submit" class="a-logout">Log out</button></form>
					</div>
				</aside>
			)}
			<main class="a-main">
				<slot />
			</main>
		</div>
	</body>
</html>

<style is:global>
	/* The admin: light grey page, white panels, the same fonts and colours as the site */
	html:has(body.admin) { background: var(--paper); }
	body.admin { min-height: 100vh; background: var(--paper); color: var(--text); font-family: var(--sans); font-size: 15.5px; line-height: 1.55; }
	.adm { display: grid; grid-template-columns: 250px 1fr; min-height: 100vh; }
	.adm.solo { grid-template-columns: 1fr; max-width: 520px; margin: 0 auto; padding-top: 80px; }
	.a-side { background: #fff; border-right: 1px solid var(--line); padding: 20px 14px; position: sticky; top: 0; height: 100vh; display: flex; flex-direction: column; overflow-y: auto; }
	.a-side .logo { margin: 0 0 18px; padding: 0 8px; font-size: 19px; }
	.a-side .logo em { font-style: normal; font-size: 12px; font-weight: 600; background: var(--navy); color: #fff; padding: 2px 8px; border-radius: 6px; }
	.a-grp { margin-top: 14px; }
	.a-grp h5 { margin: 0 0 4px; padding: 0 10px; font-size: 13px; font-weight: 500; color: var(--muted); }
	.a-grp a { display: flex; align-items: center; gap: 11px; padding: 8px 10px; border-radius: 9px; text-decoration: none; font-size: 15.5px; color: var(--navy); }
	.a-grp a:hover { background: var(--paper); }
	.a-grp a.on { background: var(--navy); color: #fff; }
	.a-grp a i { width: 10px; height: 10px; border-radius: 3px; background: var(--c); flex: none; }
	.a-side .bottom { margin-top: auto; border-top: 1px solid var(--line); padding-top: 12px; }
	body.admin .a-logout { all: unset; cursor: pointer; display: block; padding: 8px 10px; border-radius: 9px; font-size: 15.5px; color: var(--navy); }
	body.admin .a-logout:hover { background: var(--paper); }
	.a-main { padding: 28px 40px 60px; min-width: 0; }

	body.admin h1 { font-size: 30px; margin-bottom: 6px; }
	body.admin h2 { font-size: 20px; }
	body.admin a { color: var(--blue-x); }
	body.admin .a-side a { color: var(--navy); }
	body.admin .a-side a.on { color: #fff; }

	/* Forms */
	body.admin form.edit, body.admin .children, body.admin .scroll, body.admin form.login { background: #fff; border: 1px solid var(--line); border-radius: 16px; padding: 22px; }
	body.admin input, body.admin select, body.admin textarea { background: #fff; color: var(--navy); border: 1.5px solid var(--line); border-radius: 9px; padding: 9px 12px; font: inherit; font-size: 15px; }
	body.admin textarea { font-family: var(--serif); line-height: 1.6; }
	body.admin input:focus, body.admin select:focus, body.admin textarea:focus { outline: none; border-color: var(--navy); }
	body.admin input[type="checkbox"] { width: auto; accent-color: var(--navy); }
	body.admin label { color: var(--navy); }
	body.admin .help { color: var(--muted); font-size: 13.5px; margin: 0; }
	body.admin .error, body.admin .message { color: var(--red-x); }
	body.admin .message { background: var(--orange-t); }

	/* Buttons */
	body.admin button, body.admin .button { background: var(--navy); color: #fff; border: 0; border-radius: 10px; padding: 9px 16px; font: 600 15px var(--sans); cursor: pointer; text-decoration: none; display: inline-flex; align-items: center; gap: 8px; }
	body.admin button:hover, body.admin .button:hover { background: #2B3A5C; }
	body.admin form.delete { margin-top: 24px; padding: 18px 22px; background: #fff; border: 1px solid #EFC7BE; border-radius: 16px; }
	body.admin form.delete button { background: transparent; color: var(--red-x); box-shadow: inset 0 0 0 1.5px #E8B4A9; }

	/* Tables */
	body.admin table { border-collapse: collapse; width: 100%; font-size: 15px; }
	body.admin th, body.admin td { border-bottom: 1px solid var(--line); padding: 10px 12px; text-align: left; }
	body.admin th { color: var(--muted); font-weight: 500; font-size: 13px; background: #FAFBFC; }
	body.admin tr:hover td { background: #FAFBFC; }
</style>
