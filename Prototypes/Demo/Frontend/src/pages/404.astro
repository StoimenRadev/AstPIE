---
import BaseLayout from '../layouts/BaseLayout.astro';
import { t } from '../i18n/t';
---

<BaseLayout title={t('notFound.title')} theme="home" bodyClass="">
	<div class="wrap top" style="min-height:50vh">
		<h1 class="t-page">{t('notFound.title')}</h1>
		<p class="intro">{t('notFound.text')}</p>
		<p style="margin-top:28px"><a class="btn" href="/">{t('notFound.link')}</a></p>
	</div>
</BaseLayout>
