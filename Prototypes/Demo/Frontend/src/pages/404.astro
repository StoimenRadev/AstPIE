---
// Page not found, set on the paper of the Learn pages
import SiteLayout from '../layouts/SiteLayout.astro';
import LearnHeader from '../components/learn/LearnHeader.astro';
import LearnFooter from '../components/learn/LearnFooter.astro';
import { t } from '../i18n/t';
import '../styles/learn.css';
---

<SiteLayout title={t('notFound.title')} bodyClass="learn-page">
	<LearnHeader inLearn={false} />
	<main class="learn3" style="min-height:60vh">
		<h1>{t('notFound.title')}</h1>
		<p class="lead">{t('notFound.text')}</p>
		<p><a href="/">{t('notFound.link')}</a></p>
	</main>
	<LearnFooter />
</SiteLayout>

<script>
	import { setUpLearnPage } from '../scripts/learn';
	import { setUpLogoName } from '../scripts/logoName';
	import { setUpLeaving } from '../scripts/leaving';

	setUpLogoName();
	setUpLeaving();
	setUpLearnPage();
</script>
