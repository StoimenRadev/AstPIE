---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CradleArt from '../../components/art/CradleArt.astro';
import { t } from '../../i18n/t';
import { getTopics } from '../../lib/api';
import type { TopicListItem } from '../../lib/api';
import { branchDescription } from '../../lib/branches';

interface Branch
{
	name: string;
	topics: TopicListItem[];
}

const topics = await getTopics();

// Group the topics by branch. The API already sorts them by branch and order.
const branches: Branch[] = [];
for (const topic of topics)
{
	let branch = branches.find((b) => b.name === topic.branch);
	if (branch === undefined)
	{
		branch = { name: topic.branch, topics: [] };
		branches.push(branch);
	}
	branch.topics.push(topic);
}
---

<BaseLayout title={t('learn.title')} theme="learn" bodyClass="">
	<div class="wrap top">
		<h1 class="t-page">{t('learn.title')}</h1>
		<p class="intro">{t('learn.intro')}</p>
	</div>

	{topics.length === 0 && <div class="wrap"><p class="intro">{t('learn.empty')}</p></div>}

	{branches.map((branch) => (
		<div class="wrap branch">
			<aside class="branch-card">
				{branch.name === 'Classical mechanics' && <div class="ill"><CradleArt /></div>}
				<h2>{branch.name}</h2>
				<p>{branchDescription(branch.name)}</p>
			</aside>
			<ul class="topics">
				{branch.topics.map((topic) => (
					<li>
						<a href={'/learn/' + topic.slug}>
							<div>
								<h3>{topic.title}</h3>
								<p>{topic.summary}</p>
								<span class="sim-tag"><i></i>{t('learn.endsWithSim')}</span>
							</div>
							<span class="arr"><svg><use href="#i-arrow" /></svg></span>
						</a>
					</li>
				))}
			</ul>
		</div>
	))}
</BaseLayout>
