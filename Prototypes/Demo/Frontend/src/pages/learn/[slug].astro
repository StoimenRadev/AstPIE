---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SimulationPlayer from '../../components/SimulationPlayer';
import { simulationLabels } from '../../i18n/simulationLabels';
import { getTopic } from '../../lib/api';
import { renderMarkdown } from '../../lib/markdown';
import 'katex/dist/katex.min.css';

const topic = await getTopic(String(Astro.params.slug));
if (topic === null)
{
	return Astro.rewrite('/404');
}

const contentHtml = renderMarkdown(topic.content);
const labels = simulationLabels();
---

<BaseLayout title={topic.title}>
	<article>
		<h1>{topic.title}</h1>
		<p class="summary">{topic.summary}</p>

		{topic.simulations.map((simulation) => (
			<SimulationPlayer
				client:load
				title={simulation.title}
				learningGoal={simulation.learningGoal}
				buildUrl={simulation.buildUrl}
				thumbnailUrl={simulation.thumbnailUrl}
				labels={labels}
			/>
		))}

		<div class="content" set:html={contentHtml} />
	</article>
</BaseLayout>

<style>
	article {
		max-width: 60rem;
	}

	.summary {
		font-size: 1.25rem;
		color: var(--color-muted);
	}

	.content {
		max-width: 44rem;
		margin-top: var(--space-5);
	}

	/* Long formulas scroll sideways instead of widening the page */
	.content :global(.katex-display) {
		overflow-x: auto;
		overflow-y: hidden;
	}
</style>
