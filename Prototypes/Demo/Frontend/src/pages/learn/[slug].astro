---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Parts from '../../components/Parts.astro';
import SimulationPlayer from '../../components/SimulationPlayer';
import { simulationLabels } from '../../i18n/simulationLabels';
import { t } from '../../i18n/t';
import { getTopic, getTopics } from '../../lib/api';
import { hasSimulation, simulationLast, splitMarkdown } from '../../lib/chapters';
import 'katex/dist/katex.min.css';

const topic = await getTopic(String(Astro.params.slug));
if (topic === null)
{
	return Astro.rewrite('/404');
}

// The text before the first chapter is the law in one sentence.
// The chapter with the simulation always comes last.
const content = splitMarkdown(topic.content);
const chapters = simulationLast(content.chapters);
const labels = simulationLabels();

// The other topics of the same branch, for the side menu and the end of the page
const branchTopics = (await getTopics()).filter((other) => other.branch === topic.branch);
const others = branchTopics.filter((other) => other.slug !== topic.slug);
---

<BaseLayout title={topic.title} theme="learn" bodyClass="has-after">
	<div class="wrap doc" data-toc>
		<aside class="side">
			<a class="br" href="/learn">{topic.branch}</a>
			<ul>
				{branchTopics.map((item) => (
					<li class:list={{ cur: item.slug === topic.slug }}>
						<a href={'/learn/' + item.slug}>{item.title}</a>
						{item.slug === topic.slug && chapters.length > 0 && (
							<div class="subs">
								{chapters.map((chapter) => (
									<a href={'#' + chapter.id} class:list={{ sim: hasSimulation(chapter) }}>{chapter.title}</a>
								))}
							</div>
						)}
					</li>
				))}
			</ul>
		</aside>

		<article>
			<h1 class="t-page">{topic.title}</h1>
			{chapters.length > 0 && (
				<div class="law"><small>{t('learn.inOneSentence')}</small><Fragment set:html={content.intro} /></div>
			)}
			{chapters.length === 0 && <div class="read" set:html={content.intro} />}

			{chapters.map((chapter) => (
				<section class="part" id={chapter.id}>
					<h2>{chapter.title}</h2>
					{chapter.summary !== '' && <p class="sum">{chapter.summary}</p>}
					<Parts parts={chapter.parts} simulations={topic.simulations} />
				</section>
			))}

			{chapters.length === 0 && topic.simulations.length > 0 && (
				<section class="part" id="try">
					<h2>{t('learn.try')}</h2>
					{topic.simulations.map((simulation) => (
						<SimulationPlayer
							client:load
							title={simulation.title}
							learningGoal={simulation.learningGoal}
							buildUrl={simulation.buildUrl}
							thumbnailUrl={simulation.thumbnailUrl}
							labels={labels}
						/>
					))}
				</section>
			)}
		</article>
	</div>

	{others.length > 0 && (
		<section class="after-topic">
			<div class="wrap">
				<h2>{t('learn.otherTopics')} {topic.branch}</h2>
				<p class="muted">{t('learn.otherTopicsText')}</p>
				<ul class="topics">
					{others.map((other) => (
						<li><a href={'/learn/' + other.slug}><div><h3>{other.title}</h3><p>{other.summary}</p><span class="sim-tag"><i></i>{t('learn.endsWithSim')}</span></div><span class="arr"><svg><use href="#i-arrow" /></svg></span></a></li>
					))}
				</ul>
			</div>
		</section>
	)}
</BaseLayout>

<script>
	// Underline the part of the topic you are reading in the side menu
	const box = document.querySelector('[data-toc]');
	if (box !== null)
	{
		const links = box.querySelectorAll<HTMLAnchorElement>('.subs a');
		const watcher = new IntersectionObserver((seen) =>
		{
			for (const item of seen)
			{
				if (item.isIntersecting)
				{
					for (const link of links)
					{
						link.classList.toggle('on', link.getAttribute('href') === '#' + item.target.id);
					}
				}
			}
		}, { rootMargin: '-30% 0px -60% 0px' });
		for (const part of box.querySelectorAll('.part'))
		{
			watcher.observe(part);
		}
	}
</script>

<style is:global>
	.has-after .foot { margin-top: 0; }
	.law p { margin: 0; }
</style>
