---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Chapters from '../../components/Chapters.astro';
import Photo from '../../components/Photo.astro';
import SimulationPlayer from '../../components/SimulationPlayer';
import { simulationLabels } from '../../i18n/simulationLabels';
import { t } from '../../i18n/t';
import { getTopic } from '../../lib/api';
import { splitMarkdown } from '../../lib/chapters';
import { topicScene } from '../../lib/scenes';
import 'katex/dist/katex.min.css';

const topic = await getTopic(String(Astro.params.slug));
if (topic === null)
{
	return Astro.rewrite('/404');
}

// The text before the first chapter is the law in one sentence
const content = splitMarkdown(topic.content);
const labels = simulationLabels();

let thumbnail = '';
if (topic.simulations.length > 0)
{
	thumbnail = topic.simulations[0].thumbnailUrl;
}
---

<BaseLayout title={topic.title} theme="learn">
	<section class="story-hero wrap">
		<a class="back" href="/learn">← {topic.branch}</a>
		<div class="grid">
			<div>
				<h1 class="title">{topic.title}</h1>
				<p class="lede">{topic.summary}</p>
				{content.chapters.length > 0 && <div class="law-statement" set:html={content.intro} />}
				{topic.simulations.length > 0 && content.chapters.length > 0 && (
					<div style="margin-top:34px"><button class="btn" type="button" data-jump={'chapter-' + (content.chapters.findIndex((c) => c.parts.some((p) => p.kind === 'simulation')) + 1)}>▶ {t('learn.try')}</button></div>
				)}
			</div>
			<div class="hero-photo"><Photo src={thumbnail} scene={topicScene(topic.slug, topic.branch)} className="" /></div>
		</div>
	</section>

	<Chapters chapters={content.chapters} simulations={topic.simulations} />

	{content.chapters.length === 0 && (
		<section class="wrap" style="padding-top:80px">
			{topic.simulations.map((simulation) => (
				<SimulationPlayer
					client:load
					title={simulation.title}
					learningGoal={simulation.learningGoal}
					buildUrl={simulation.buildUrl}
					thumbnailUrl={simulation.thumbnailUrl}
					labels={labels}
				/>
			))}
			<div class="read" style="margin-top:60px" set:html={content.intro} />
		</section>
	)}

	<div class="wrap" style="padding-top:60px"><a class="btn quiet" href="/learn">← {topic.branch}</a></div>
</BaseLayout>
