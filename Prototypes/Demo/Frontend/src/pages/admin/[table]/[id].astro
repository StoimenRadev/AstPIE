---
// Create (/admin/topics/new) or edit (/admin/topics/5) one row, and delete it.
// An entry's page also lists its chapters, people and media.
import AdminLayout from '../../../layouts/AdminLayout.astro';
import FieldInput from '../../../components/admin/FieldInput.astro';
import { ADMIN_COOKIE, adminRequest, readKey } from '../../../lib/admin/client';
import { findTable } from '../../../lib/admin/config';
import type { TableConfig } from '../../../lib/admin/config';
import { displayValue, loadChoices, readForm, safeBackLink } from '../../../lib/admin/forms';
import type { Choice } from '../../../lib/admin/forms';

const table = findTable(String(Astro.params.table));
if (table === null)
{
	return Astro.rewrite('/404');
}

const id = String(Astro.params.id);
const isNew = id === 'new';
const key = readKey(Astro.cookies);
const listLink = '/admin/' + table.key;
// After saving or deleting, go back here (for example to the entry a chapter belongs to)
const back = safeBackLink(Astro.url.searchParams.get('back'), listLink);

let values: Record<string, unknown> = {};
let fieldErrors: Record<string, string> = {};
let message = '';

function goToLogin()
{
	Astro.cookies.delete(ADMIN_COOKIE, { path: '/admin' });
	return Astro.redirect('/admin/login');
}

// ---------- Saving and deleting ----------

if (Astro.request.method === 'POST')
{
	const form = await Astro.request.formData();

	if (form.get('_action') === 'delete')
	{
		const answer = await adminRequest(key, 'DELETE', '/' + table.key + '/' + id, null);
		if (answer.status === 401)
		{
			return goToLogin();
		}
		if (answer.ok)
		{
			return Astro.redirect(back);
		}
		message = answer.message;
	}
	else
	{
		const sent = await readForm(key, table, form);
		values = sent.values;
		fieldErrors = sent.fieldErrors;

		if (Object.keys(fieldErrors).length > 0)
		{
			message = 'Some fields need fixing.';
		}
		else
		{
			let answer;
			if (isNew)
			{
				answer = await adminRequest(key, 'POST', '/' + table.key, sent.body);
			}
			else
			{
				answer = await adminRequest(key, 'PUT', '/' + table.key + '/' + id, sent.body);
			}
			if (answer.status === 401)
			{
				return goToLogin();
			}
			if (answer.ok)
			{
				// A new entry opens its own page, so chapters, people and media can be added next
				if (isNew && table.children.length > 0)
				{
					return Astro.redirect(listLink + '/' + answer.data.id);
				}
				return Astro.redirect(back);
			}
			message = answer.message;
			fieldErrors = answer.fieldErrors;
		}
	}
}

// ---------- The values to show ----------

// Nothing typed yet (first visit, or a delete that was refused): load the saved values
if (Object.keys(values).length === 0)
{
	if (isNew)
	{
		// A new chapter, person link or media item can arrive with its entry already chosen
		if (table.parentField !== '')
		{
			const parentId = Astro.url.searchParams.get(table.parentField);
			if (parentId !== null)
			{
				values[table.parentField] = parentId;
			}
		}
	}
	else
	{
		const answer = await adminRequest(key, 'GET', '/' + table.key + '/' + id, null);
		if (answer.status === 401)
		{
			return goToLogin();
		}
		if (answer.status === 404)
		{
			return Astro.rewrite('/404');
		}
		values = answer.data;
	}
}

const choices = await loadChoices(key, table.fields);

let heading = 'New ' + table.singular;
if (!isNew)
{
	heading = String(values[table.labelField]);
}

// ---------- Chapters, people and media of an entry ----------

interface ChildSection
{
	table: TableConfig;
	rows: any[];
	choices: Record<string, Choice[]>;
}

const childSections: ChildSection[] = [];
if (!isNew)
{
	for (const childKey of table.children)
	{
		const child = findTable(childKey);
		if (child !== null)
		{
			const answer = await adminRequest(key, 'GET', '/' + child.key + '?' + child.parentField + '=' + id, null);
			let rows: any[] = [];
			if (answer.ok)
			{
				rows = answer.data;
			}
			childSections.push({ table: child, rows: rows, choices: await loadChoices(key, child.fields) });
		}
	}
}

const here = listLink + '/' + id;

// ---------- The tabs of the editor ----------

interface Tab
{
	id: string;
	title: string;
	hint: string;
	appears: string;
	// The fields of this tab; empty for a tab that lists child rows
	fields: string[];
	// Set for a tab that lists parts, people or images
	child: ChildSection | null;
	// true when something in the tab still needs filling in
	warn: boolean;
}

function isEmpty(name: string): boolean
{
	const value = values[name];
	return value === null || value === undefined || String(value).trim() === '';
}

const tabs: Tab[] = [];
let sections = table.sections;
if (sections.length === 0)
{
	sections = [{ title: 'Details', hint: '', appears: '', fields: table.fields.map((f) => f.name) }];
}
for (let i = 0; i < sections.length; i++)
{
	const sec = sections[i];
	// A required field that is empty, or a picture that is missing, marks the tab
	let warn = false;
	for (const name of sec.fields)
	{
		const f = table.fields.find((x) => x.name === name);
		if (f !== undefined && !isNew && (f.required || f.type === 'file') && isEmpty(name))
		{
			warn = true;
		}
	}
	tabs.push({ id: 'tab-' + i, title: sec.title, hint: sec.hint, appears: sec.appears, fields: sec.fields, child: null, warn: warn });
}

// Child tables become tabs too, placed before "Publishing"
const CHILD_INFO: Record<string, { hint: string; appears: string }> = {
	'chapters': { hint: 'The pages in order. Pages with the same section follow each other under one coloured tab.', appears: 'tabs' },
	'entry-facts': { hint: 'The rows on the cover sheet, in order.', appears: 'cover' },
	'media': { hint: 'Each thing lands on the desk with its page. Without a page it lies on the case summary; Audio and Signal without a page are tapes for the radio.', appears: 'desk' },
	'explanations': { hint: 'Mysteries only: the cards pinned on the cork board, with their stamp.', appears: 'desk' },
	'entry-people': { hint: 'People are shared between cases. Link someone who already exists, or add a new person first.', appears: 'photos' },
	'media-people': { hint: 'Who this photo shows. One person: it is one of their own photos. Several: they are on it together. Only people of the case are listed in the photo folder.', appears: '' },
	'topic-symbols': { hint: 'The rows of "Reading it symbol by symbol", in order.', appears: 'law' },
	'check-questions': { hint: 'Each question sits after the section it names, with its answer behind a button.', appears: 'parts' },
	'topic-key-words': { hint: 'The key words this topic marks in its text. Add new words under Key words first.', appears: 'keywords' },
	'lab-tasks': { hint: 'The tasks on the lab sheet, in order.', appears: '' },
	'catalogue-facts': { hint: 'The rows on the left page of the logbook, in order.', appears: 'left' },
	'log-entries': { hint: 'The observation log, oldest first.', appears: 'log' },
	'catalogue-instruments': { hint: 'The instruments in the stack on the observatory desk.', appears: 'instruments' }
};
const childTabs: Tab[] = childSections.map((section, i) =>
{
	let info = { hint: '', appears: '' };
	if (section.table.key in CHILD_INFO)
	{
		info = CHILD_INFO[section.table.key];
	}
	const warn = section.rows.length === 0 && (section.table.key === 'chapters' || section.table.key === 'log-entries');
	return { id: 'child-' + i, title: section.table.title, hint: info.hint, appears: info.appears, fields: [], child: section, warn: warn };
});
const publishIndex = tabs.findIndex((tab) => tab.title === 'Publishing');
if (publishIndex === -1)
{
	tabs.push(...childTabs);
}
else
{
	tabs.splice(publishIndex, 0, ...childTabs);
}

// ---------- Before publishing ----------

const checks: { ok: boolean; text: string }[] = [];
if (!isNew)
{
	for (const f of table.fields)
	{
		if (f.type === 'file' && f.name !== 'thumbnailUrl')
		{
			checks.push({ ok: !isEmpty(f.name), text: f.label + ' added' });
		}
	}
	for (const section of childSections)
	{
		checks.push({ ok: section.rows.length > 0, text: section.rows.length + ' ' + section.table.title.toLowerCase() });
	}
	if (table.key === 'topics')
	{
		checks.push({ ok: String(values['content']).includes('[[simulation]]'), text: 'The text places the simulation' });
	}
	if (table.fields.some((f) => f.name === 'isPublished'))
	{
		checks.push({ ok: values['isPublished'] === true, text: 'Published' });
	}
}

// The public page of this row, for the "View on the site" link
let viewLink = '';
if (!isNew && table.key === 'entries')
{
	let section = 'missions';
	if (values['kind'] === 'Mystery')
	{
		section = 'mysteries';
	}
	viewLink = '/explore/' + section + '/' + values['slug'];
}
if (!isNew && table.key === 'catalogue')
{
	viewLink = '/explore/catalogue/' + values['slug'];
}
if (!isNew && table.key === 'topics')
{
	viewLink = '/learn/' + values['slug'];
}

function rowLabel(section: ChildSection, row: any): string
{
	return section.table.listColumns
		.filter((name) => name !== section.table.parentField)
		.map((name) =>
		{
			const f = section.table.fields.find((x) => x.name === name);
			if (f === undefined)
			{
				return '';
			}
			return displayValue(f, row[name], section.choices);
		})
		.filter((text) => text !== '')
		.join(' · ');
}

function rowLink(section: ChildSection, row: any): string
{
	return '/admin/' + section.table.key + '/' + row.id + '?back=' + encodeURIComponent(here);
}

function addLink(section: ChildSection): string
{
	return '/admin/' + section.table.key + '/new?' + section.table.parentField + '=' + id + '&back=' + encodeURIComponent(here);
}

let topNote = 'Every tab is saved together.';
if (isNew)
{
	topNote = 'Fill in the tabs from top to bottom, then save.';
}
---

<AdminLayout title={heading} showMenu={true}>
	<a class="back" href={back}>← {table.title}</a>
	<form method="post" enctype="multipart/form-data" class="ed-form" id="edit-form">
		<div class="ed-top">
			<div>
				<h1>{heading}</h1>
				<p class="muted">{topNote}</p>
			</div>
			<button type="submit" class="save">Save</button>
		</div>

		{message !== '' && <p class="message">{message}</p>}

		<div class="ed">
			<nav class="ed-nav">
				{tabs.map((tab, i) => (
					<button type="button" data-tab={tab.id} data-appears={tab.appears} class:list={{ on: i === 0 }}>{tab.title}<i class:list={{ w: tab.warn }}></i></button>
				))}
			</nav>

			<div>
				{tabs.map((tab, i) => (
					<section class:list={['pane', { on: i === 0 }]} data-pane={tab.id}>
						<div class="pnl">
							<div class="pnl-h"><h2>{tab.title}</h2>{tab.hint !== '' && <p>{tab.hint}</p>}</div>
							<div class="pnl-b">
								{table.fields.filter((f) => tab.fields.includes(f.name)).map((f) => (
									<FieldInput
										field={f}
										value={values[f.name]}
										error={fieldErrors[f.name] || ''}
										choices={choices[f.refTable] || []}
										locked={!isNew && f.lockedOnEdit}
									/>
								))}

								{tab.child !== null && tab.child.rows.length === 0 && <p class="muted">None yet.</p>}
								{tab.child !== null && tab.child.rows.length > 0 && (
									<ol class="rows">
										{tab.child.rows.map((row) => (
											<li><a href={rowLink(tab.child as ChildSection, row)}>{rowLabel(tab.child as ChildSection, row)}</a><span>Edit</span></li>
										))}
									</ol>
								)}
								{tab.child !== null && <a class="addrow" href={addLink(tab.child)}>Add {tab.child.table.singular}</a>}
							</div>
						</div>
					</section>
				))}
			</div>

			<aside class="ed-side">
				{table.pageMap.length > 0 && (
					<div class="pnl">
						<h3>Where this appears on the page</h3>
						<div class="map">
							{table.pageMap.map((part) => <div class={'a-' + part.area} data-m={part.key}>{part.label}</div>)}
						</div>
					</div>
				)}
				{checks.length > 0 && (
					<div class="pnl">
						<h3>Before publishing</h3>
						<ul class="checks">
							{checks.map((check) => <li class:list={{ ok: check.ok }}>{check.text}</li>)}
						</ul>
					</div>
				)}
				{viewLink !== '' && <a class="view" href={viewLink} target="_blank">View on the site</a>}
			</aside>
		</div>
	</form>

	{!isNew && (
		<form method="post" class="delete" onsubmit="return confirm('Delete this for good?');">
			<div><b>Delete this {table.singular}</b><p>This cannot be undone.{table.children.length > 0 && ' Everything listed on its tabs goes with it. People and instruments themselves stay.'}</p></div>
			<input type="hidden" name="_action" value="delete" />
			<button type="submit">Delete</button>
		</form>
	)}
</AdminLayout>

<script>
	// Tabs: show one pane at a time and light up its part of the page map
	const nav = document.querySelector('.ed-nav');
	if (nav !== null)
	{
		const buttons = Array.from(nav.querySelectorAll<HTMLButtonElement>('button'));
		function show(button: HTMLButtonElement)
		{
			for (const b of buttons)
			{
				b.classList.toggle('on', b === button);
			}
			for (const pane of document.querySelectorAll<HTMLElement>('.pane'))
			{
				pane.classList.toggle('on', pane.dataset.pane === button.dataset.tab);
			}
			for (const part of document.querySelectorAll<HTMLElement>('.map [data-m]'))
			{
				part.classList.toggle('hi', part.dataset.m === button.dataset.appears);
			}
		}
		for (const button of buttons)
		{
			button.addEventListener('click', () => show(button));
		}
		// When saving found a mistake, open the tab with the first wrong field
		let first = buttons[0];
		const error = document.querySelector('.pane .has-error');
		if (error !== null)
		{
			const pane = error.closest<HTMLElement>('.pane');
			for (const b of buttons)
			{
				if (pane !== null && b.dataset.tab === pane.dataset.pane)
				{
					first = b;
				}
			}
		}
		if (first !== undefined)
		{
			show(first);
		}
	}
</script>

<style>
	.back { display: inline-block; font-size: 14.5px; color: var(--muted) !important; text-decoration: none; margin-bottom: 6px; }
	.ed-top { display: flex; justify-content: space-between; align-items: center; gap: 18px; margin-bottom: 20px; }
	.ed-top p { margin: 0; }
	.ed { display: grid; grid-template-columns: 210px minmax(0, 1fr) 260px; gap: 22px; align-items: start; }
	.ed-nav { position: sticky; top: 20px; background: #fff; border: 1px solid var(--line); border-radius: 14px; padding: 8px; }
	body.admin .ed-nav button { all: unset; box-sizing: border-box; cursor: pointer; width: 100%; display: flex; justify-content: space-between; align-items: center; gap: 10px; padding: 10px 12px; border-radius: 9px; font-size: 15px; color: var(--navy); }
	body.admin .ed-nav button:hover { background: var(--paper); }
	body.admin .ed-nav button.on { background: var(--orange-t); font-weight: 600; }
	.ed-nav i { width: 8px; height: 8px; border-radius: 50%; background: #3BA56B; flex: none; }
	.ed-nav i.w { background: var(--orange); }
	.pane { display: none; }
	.pane.on { display: block; }
	.pnl { background: #fff; border: 1px solid var(--line); border-radius: 16px; }
	.pnl-h { padding: 16px 20px; border-bottom: 1px solid var(--line); }
	.pnl-h h2 { font-size: 18px; }
	.pnl-h p { margin: 2px 0 0; font-size: 14px; color: var(--muted); }
	.pnl-b { padding: 20px; }
	.rows { list-style: none; margin: 0 0 14px; padding: 0; }
	.rows li { display: flex; justify-content: space-between; gap: 12px; border: 1px solid var(--line); border-radius: 10px; margin-bottom: 8px; }
	.rows li:hover { border-color: var(--navy); }
	.rows a { flex: 1; padding: 11px 14px; color: var(--navy) !important; text-decoration: none; font-weight: 500; }
	.rows span { padding: 11px 14px; font-size: 13.5px; color: var(--muted); }
	.addrow { display: block; text-align: center; padding: 12px; border: 2px dashed var(--line); border-radius: 12px; color: var(--muted) !important; font-weight: 500; text-decoration: none; }
	.addrow:hover { border-color: var(--navy); color: var(--navy) !important; }
	.ed-side { position: sticky; top: 20px; display: grid; gap: 14px; }
	.ed-side .pnl { padding: 16px; }
	.ed-side h3 { font-size: 15.5px; margin-bottom: 10px; }
	.map { display: grid; grid-template-columns: 22% 1fr 30%; grid-auto-rows: minmax(26px, auto); gap: 5px; }
	.map div { border-radius: 6px; background: var(--paper); font-size: 11.5px; color: var(--muted); padding: 6px 7px; transition: background 0.2s, color 0.2s; }
	.map .a-side { grid-column: 1; grid-row: 1 / span 5; }
	.map .a-main { grid-column: 2; }
	.map .a-info { grid-column: 3; grid-row: 1 / span 3; }
	.map .a-wide { grid-column: 2 / 4; }
	.map .hi { background: var(--orange); color: #fff; }
	.checks { list-style: none; margin: 0; padding: 0; font-size: 14px; }
	.checks li { display: flex; gap: 8px; align-items: center; padding: 6px 0; border-top: 1px solid var(--line); color: var(--navy); }
	.checks li::before { content: ''; width: 9px; height: 9px; border-radius: 50%; background: var(--orange); flex: none; }
	.checks li.ok::before { background: #3BA56B; }
	.view { display: block; text-align: center; padding: 11px; border-radius: 10px; border: 1.5px solid var(--line); text-decoration: none; font-weight: 600; color: var(--navy) !important; background: #fff; }
	body.admin form.ed-form { background: none; border: 0; padding: 0; }
	body.admin form.delete { display: flex; justify-content: space-between; align-items: center; gap: 16px; }
	form.delete p { margin: 2px 0 0; font-size: 14px; color: var(--muted); }
</style>
