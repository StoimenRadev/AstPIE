---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { ADMIN_COOKIE, checkKey } from '../../lib/admin/client';

let error = '';

if (Astro.request.method === 'POST')
{
	const form = await Astro.request.formData();
	const key = String(form.get('key')).trim();

	if (key !== '' && await checkKey(key))
	{
		// httpOnly: JavaScript can't read it. SameSite=Strict: other sites can't use it.
		Astro.cookies.set(ADMIN_COOKIE, key, {
			httpOnly: true,
			sameSite: 'strict',
			secure: Astro.url.protocol === 'https:',
			path: '/admin',
			maxAge: 60 * 60 * 8
		});
		return Astro.redirect('/admin');
	}
	error = 'This key is not accepted.';
}
---

<AdminLayout title="Log in" showMenu={false}>
	<form method="post" class="login">
		<h1>Admin</h1>
		<label for="key">Admin key</label>
		<input id="key" name="key" type="password" autocomplete="current-password" required autofocus />
		{error !== '' && <p class="error">{error}</p>}
		<button type="submit">Log in</button>
	</form>
</AdminLayout>

<style>
	.login {
		display: flex;
		flex-direction: column;
		gap: var(--space-2);
		max-width: 22rem;
	}

	input {
		padding: var(--space-2);
		border: 1px solid var(--color-border);
		border-radius: 0.375rem;
		font: inherit;
	}

	button {
		padding: var(--space-2) var(--space-4);
		border: 0;
		border-radius: 0.375rem;
		background: var(--art-ink);
		color: var(--art-cream);
		font: inherit;
		font-weight: 600;
		cursor: pointer;
	}

	.error {
		margin: 0;
		color: #F28B82;
	}
</style>
