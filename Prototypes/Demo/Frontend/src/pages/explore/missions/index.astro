---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Slot from '../../../components/Slot.astro';
import YearLine from '../../../components/YearLine.astro';
import { t } from '../../../i18n/t';
import { getEntries } from '../../../lib/api';
import { countryName, countryOf } from '../../../lib/country';
import { formatDate, outcomeLabel } from '../../../lib/format';

const missions = await getEntries('Mission');

// The colour of the dot before the outcome
function outcomeColour(outcome: string | null): string
{
	if (outcome === 'Success')
	{
		return 'blue';
	}
	if (outcome === 'Ongoing')
	{
		return 'orange';
	}
	return 'yellow';
}

const rows = missions.map((mission) =>
{
	let outcome = '';
	if (mission.missionOutcome !== null)
	{
		outcome = mission.missionOutcome;
	}
	let date = '';
	if (mission.startDate !== null)
	{
		date = formatDate(mission.startDate);
	}
	return {
		mission: mission,
		country: countryOf(mission.agency),
		countryName: countryName(mission.agency),
		outcome: outcome,
		outcomeText: outcomeLabel(outcome),
		colour: outcomeColour(mission.missionOutcome),
		date: date
	};
});
---

<BaseLayout title={t('missions.title')} theme="missions" bodyClass="">
	<div class="wrap top">
		<h1 class="t-page">{t('missions.title')}</h1>
		<p class="intro">{t('missions.description')}</p>
	</div>
	<div class="wrap">
		<YearLine missions={missions} />

		{missions.length === 0 && <p class="intro">{t('missions.empty')}</p>}
		{missions.length > 0 && (
			<div data-filter>
				<div class="filters">
					<div class="grp" data-key="country">
						<span>{t('missions.country')}</span>
						<button class="chip on" data-v="">{t('explore.all')}</button>
						<button class="chip" data-v="ussr">{t('country.ussr')}</button>
						<button class="chip" data-v="usa">{t('country.usa')}</button>
					</div>
					<div class="grp" data-key="outcome">
						<span>{t('missions.outcome')}</span>
						<button class="chip on" data-v="">{t('explore.all')}</button>
						<button class="chip" data-v="Success">{t('outcome.Success')}</button>
						<button class="chip" data-v="PartialSuccess">{t('outcome.PartialSuccess')}</button>
						<button class="chip" data-v="Ongoing">{t('outcome.Ongoing')}</button>
					</div>
					<span class="cnt" data-cnt data-noun={t('explore.missionsCount')}>{missions.length} {t('explore.missionsCount')}</span>
				</div>
				<ul class="entries">
					{rows.map((row) => (
						<li data-country={row.country} data-outcome={row.outcome}>
							<a class="entry" href={'/explore/missions/' + row.mission.slug}>
								<Slot src={row.mission.coverImageUrl} ratio="4 / 3" empty="" className="" />
								<div>
									<h3>{row.mission.title}</h3>
									<div class="meta">
										{row.date !== '' && <span>{row.date}</span>}
										{row.countryName !== '' && <span>{row.countryName}</span>}
										{row.outcome !== '' && <span class={'dot ' + row.colour}>{row.outcomeText}</span>}
									</div>
									<p>{row.mission.summary}</p>
								</div>
								<span class="arr"><svg><use href="#i-arrow" /></svg></span>
							</a>
						</li>
					))}
				</ul>
				<p class="none" hidden>{t('missions.noMatch')}</p>
			</div>
		)}
	</div>
</BaseLayout>

<script>
	// Show only the missions that match every chosen filter
	const box = document.querySelector<HTMLElement>('[data-filter]');
	if (box !== null)
	{
		const chosen: Record<string, string> = {};
		const items = box.querySelectorAll<HTMLElement>('.entries li');
		const count = box.querySelector<HTMLElement>('[data-cnt]');
		const none = box.querySelector<HTMLElement>('.none');
		for (const group of box.querySelectorAll<HTMLElement>('.grp'))
		{
			group.addEventListener('click', (event) =>
			{
				const chip = (event.target as HTMLElement).closest<HTMLElement>('.chip');
				if (chip === null)
				{
					return;
				}
				for (const other of group.querySelectorAll('.chip'))
				{
					other.classList.remove('on');
				}
				chip.classList.add('on');
				chosen[String(group.dataset.key)] = String(chip.dataset.v);
				let shown = 0;
				for (const item of items)
				{
					let match = true;
					for (const key of Object.keys(chosen))
					{
						if (chosen[key] !== '' && item.dataset[key] !== chosen[key])
						{
							match = false;
						}
					}
					item.hidden = !match;
					if (match)
					{
						shown++;
					}
				}
				if (count !== null)
				{
					count.textContent = shown + ' ' + count.dataset.noun;
				}
				if (none !== null)
				{
					none.hidden = shown > 0;
				}
			});
		}
	}
</script>
