---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import EntryPage from '../../../components/EntryPage.astro';
import { getEntry } from '../../../lib/api';

const entry = await getEntry(String(Astro.params.slug));

// A mystery opened under /missions is the wrong address: show the 404 page
if (entry === null || entry.kind !== 'Mission')
{
	return Astro.rewrite('/404');
}
---

<BaseLayout title={entry.title}>
	<EntryPage entry={entry} basePath="/explore/missions" />
</BaseLayout>
