---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Slot from '../../../components/Slot.astro';
import { t } from '../../../i18n/t';
import { getCatalogue, getCatalogueFilters } from '../../../lib/api';
import { formatDistance, formatValue, objectTypeLabel } from '../../../lib/format';

// The search and filters are a plain form: the page reads them from the address
// (?q=...&type=...&con=...&dist=...&page=...) and asks the API for that page.
const params = Astro.url.searchParams;

function read(name: string): string
{
	const value = params.get(name);
	if (value === null)
	{
		return '';
	}
	return value.trim();
}

const search = read('q');
const type = read('type');
const constellation = read('con');
const distance = read('dist');
let page = Number(read('page'));
if (!Number.isInteger(page) || page < 1)
{
	page = 1;
}

// The distance choices, in light-years
const DISTANCES = [
	{ value: '0-100', label: t('catalogue.closerThan100'), min: 0, max: 100 },
	{ value: '100-10000', label: t('catalogue.between'), min: 100, max: 10000 },
	{ value: '10000-', label: t('catalogue.fartherThan'), min: 10000, max: 0 }
];
let minDistance = 0;
let maxDistance = 0;
for (const choice of DISTANCES)
{
	if (choice.value === distance)
	{
		minDistance = choice.min;
		maxDistance = choice.max;
	}
}

const filters = await getCatalogueFilters();
const result = await getCatalogue({ search: search, type: type, constellation: constellation, minDistance: minDistance, maxDistance: maxDistance, page: page, pageSize: 12 });

// The address of another page with the same search and filters
function pageLink(number: number): string
{
	const next = new URLSearchParams(params);
	next.set('page', String(number));
	return '/explore/catalogue?' + next.toString();
}

const pages = [];
for (let i = 1; i <= result.totalPages; i++)
{
	pages.push(i);
}

const first = (result.page - 1) * result.pageSize + 1;
const last = first + result.items.length - 1;
const anyFilter = search !== '' || type !== '' || constellation !== '' || distance !== '';
---

<BaseLayout title={t('catalogue.title')} theme="catalogue" bodyClass="">
	<div class="wrap top">
		<h1 class="t-page">{t('catalogue.title')}</h1>
		<p class="intro">{t('catalogue.description')}</p>
	</div>

	<div class="wrap">
		<form method="get" action="/explore/catalogue">
			<div class="search" style="margin-top:0">
				<input type="search" name="q" value={search} placeholder={t('catalogue.searchHint')} aria-label={t('catalogue.search')} />
				<button class="btn" type="submit">{t('catalogue.search')}</button>
			</div>
			<div class="cfil">
				<div class="fld">
					<label for="f-type">{t('catalogue.type')}</label>
					<select id="f-type" name="type" data-auto>
						<option value="">{t('catalogue.allTypes')}</option>
						{filters.types.map((value) => <option value={value} selected={value === type}>{objectTypeLabel(value)}</option>)}
					</select>
				</div>
				<div class="fld">
					<label for="f-con">{t('catalogue.constellation')}</label>
					<select id="f-con" name="con" data-auto>
						<option value="">{t('catalogue.allConstellations')}</option>
						{filters.constellations.map((value) => <option value={value} selected={value === constellation}>{value}</option>)}
					</select>
				</div>
				<div class="fld">
					<label for="f-dist">{t('catalogue.distance')}</label>
					<select id="f-dist" name="dist" data-auto>
						<option value="">{t('catalogue.anyDistance')}</option>
						{DISTANCES.map((choice) => <option value={choice.value} selected={choice.value === distance}>{choice.label}</option>)}
					</select>
				</div>
				<button class="btn ghost sm" type="submit">{t('catalogue.apply')}</button>
				{anyFilter && <a class="btn ghost sm" href="/explore/catalogue">{t('catalogue.clear')}</a>}
			</div>
		</form>

		{result.items.length > 0 && (
			<table class="ctab">
				<thead><tr><th>{t('catalogue.object')}</th><th>{t('catalogue.type')}</th><th>{t('catalogue.constellation')}</th><th>{t('catalogue.distance')}</th><th></th></tr></thead>
				<tbody>
					{result.items.map((item) => (
						<tr>
							<td><a class="nm" href={'/explore/catalogue/' + item.slug}><Slot src={item.imageUrl} ratio="1 / 1" empty="" className="" /><div><b>{item.name}</b><span>{item.summary.substring(0, 70)}…</span></div></a></td>
							<td>{objectTypeLabel(item.type)}</td>
							<td>{formatValue(item.constellation)}</td>
							<td>{formatDistance(item.distanceLy)}</td>
							<td><a href={'/explore/catalogue/' + item.slug} class="link">{t('catalogue.open')}</a></td>
						</tr>
					))}
				</tbody>
			</table>
		)}
		{result.items.length === 0 && <p class="none">{t('catalogue.noMatch')}</p>}

		{result.totalCount > 0 && (
			<div class="pager">
				<span class="muted" style="font-size:14px">{t('catalogue.showing')} {first}–{last} {t('catalogue.of')} {result.totalCount}</span>
				<div class="pg">
					{pages.map((number) => <a class:list={['chip', { on: number === result.page }]} href={pageLink(number)}>{t('catalogue.page')} {number}</a>)}
				</div>
			</div>
		)}
	</div>
</BaseLayout>

<script>
	// A new choice in a list sends the form at once
	for (const select of document.querySelectorAll<HTMLSelectElement>('select[data-auto]'))
	{
		select.addEventListener('change', () =>
		{
			if (select.form !== null)
			{
				select.form.submit();
			}
		});
	}
</script>
