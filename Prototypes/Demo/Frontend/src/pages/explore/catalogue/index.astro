---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { t } from '../../../i18n/t';
import { getCatalogue } from '../../../lib/api';
import { formatDistance, objectTypeLabel } from '../../../lib/format';

// A simple list for now. Search, filters and pages come when there are more objects
// (the API already supports them).
const catalogue = await getCatalogue();
---

<BaseLayout title={t('catalogue.title')}>
	<h1>{t('catalogue.title')}</h1>
	<p>{t('catalogue.description')}</p>

	{catalogue.items.length === 0 && <p>{t('catalogue.empty')}</p>}

	<div class="cards">
		{catalogue.items.map((item) => (
			<a class="card" href={'/explore/catalogue/' + item.slug}>
				<h2>{item.name}</h2>
				<p class="meta">
					<span>{objectTypeLabel(item.type)}</span>
					{item.constellation !== null && <span>{item.constellation}</span>}
					<span>{formatDistance(item.distanceLy)}</span>
				</p>
				<p class="summary">{item.summary}</p>
			</a>
		))}
	</div>
</BaseLayout>

<style>
	.cards {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(18rem, 1fr));
		gap: var(--space-3);
		margin-top: var(--space-4);
	}

	.card {
		display: block;
		padding: var(--space-4);
		border: 1px solid var(--color-border);
		border-radius: 0.5rem;
		color: var(--color-text);
		text-decoration: none;
	}

	.card:hover {
		background: var(--color-surface);
	}

	h2 {
		margin: 0;
		font-size: 1.25rem;
	}

	.meta {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-1) var(--space-3);
		margin: var(--space-2) 0;
		color: var(--color-muted);
		font-size: 0.875rem;
	}

	.summary {
		margin: 0;
	}
</style>
