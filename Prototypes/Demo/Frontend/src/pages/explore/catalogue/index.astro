---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Photo from '../../../components/Photo.astro';
import Scene from '../../../components/Scene.astro';
import { t } from '../../../i18n/t';
import { getCatalogue } from '../../../lib/api';
import { formatDistance, formatValue, objectTypeLabel } from '../../../lib/format';

// A simple list for now. Search, filters and pages come when there are more objects
// (the API already supports them).
const catalogue = await getCatalogue();
---

<BaseLayout title={t('catalogue.title')} theme="catalogue">
	<section class="scene-hero">
		<Scene name="scene-catalogue" className="" />
		<div class="copy wrap"><div class="inner">
			<h1 class="display">{t('catalogue.title')}</h1>
			<p class="lede">{t('catalogue.description')}</p>
		</div></div>
	</section>

	<section class="wrap" style="padding-top:40px">
		{catalogue.items.length === 0 && <p class="lede">{t('catalogue.empty')}</p>}
		<div class="cards">
			{catalogue.items.map((item) => (
				<a class="card obj-card" href={'/explore/catalogue/' + item.slug}>
					<Photo src={item.imageUrl} scene="scene-catalogue" className="" />
					<h3>{item.name}</h3>
					<div class="facts">
						<span><b>{objectTypeLabel(item.type)}</b>{t('catalogue.type')}</span>
						<span><b>{formatValue(item.constellation)}</b>{t('catalogue.constellation')}</span>
						<span><b>{formatDistance(item.distanceLy)}</b>{t('catalogue.distance')}</span>
					</div>
				</a>
			))}
		</div>
	</section>
</BaseLayout>
