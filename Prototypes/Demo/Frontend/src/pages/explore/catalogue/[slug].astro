---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Chapters from '../../../components/Chapters.astro';
import Photo from '../../../components/Photo.astro';
import { t } from '../../../i18n/t';
import { getCatalogue, getCatalogueObject } from '../../../lib/api';
import { splitMarkdown } from '../../../lib/chapters';
import { formatDistance, formatMass, formatRadius, formatValue, objectTypeLabel } from '../../../lib/format';

const item = await getCatalogueObject(String(Astro.params.slug));
if (item === null)
{
	return Astro.rewrite('/404');
}

// The key facts under the header; values that are not known say so
const facts = [
	{ label: t('catalogue.type'), value: objectTypeLabel(item.type) },
	{ label: t('catalogue.constellation'), value: formatValue(item.constellation) },
	{ label: t('catalogue.distance'), value: formatDistance(item.distanceLy) },
	{ label: t('catalogue.mass'), value: formatMass(item.massKg, item.type) },
	{ label: t('catalogue.radius'), value: formatRadius(item.radiusKm, item.type) },
	{ label: t('catalogue.otherNames'), value: formatValue(item.otherNames) },
	{ label: t('catalogue.discoveredBy'), value: formatValue(item.discoveredBy) },
	{ label: t('catalogue.discoveryYear'), value: formatValue(item.discoveryYear) }
];

// The description is cut into chapters at its "## " titles
const content = splitMarkdown(item.description);

const others = (await getCatalogue()).items.filter((o) => o.slug !== item.slug).slice(0, 3);
---

<BaseLayout title={item.name} theme="catalogue">
	<section class="story-hero wrap">
		<a class="back" href="/explore/catalogue">← {t('entry.allObjects')}</a>
		<div class="grid">
			<div>
				<h1 class="title">{item.name}</h1>
				<p class="lede">{item.summary}</p>
				<div class="tagline"><span>{objectTypeLabel(item.type)}</span>{item.constellation !== null && <span>{item.constellation}</span>}{item.discoveryYear !== null && <span>{item.discoveryYear}</span>}</div>
			</div>
			<div class="hero-photo"><Photo src={item.imageUrl} scene="scene-catalogue" className="" /></div>
		</div>
		<dl class="sheet">
			{facts.map((fact) => <div><dt>{fact.label}</dt><dd>{fact.value}</dd></div>)}
		</dl>
	</section>

	<Chapters chapters={content.chapters} simulations={[]} />
	{content.chapters.length === 0 && <section class="wrap" style="padding-top:80px"><div class="read" set:html={content.intro} /></section>}

	{item.relatedTopic !== null && (
		<section class="wrap" style="padding-top:120px">
			<div class="section-title"><div><h2>{t('entry.physics')}</h2><p>{t('entry.physicsText')}</p></div><a class="more" href={'/learn/' + item.relatedTopic.slug}>{item.relatedTopic.title} →</a></div>
		</section>
	)}

	{others.length > 0 && (
		<section class="wrap after">
			<div class="section-title"><div><h2>{t('entry.keepExploring')}</h2></div><a class="more" href="/explore/catalogue">{t('entry.allObjects')} →</a></div>
			<div class="tiles">
				{others.map((other) => (
					<a class="tile" href={'/explore/catalogue/' + other.slug}><Photo src={other.imageUrl} scene="scene-catalogue" className="" /><h4>{other.name}</h4><p>{other.summary}</p></a>
				))}
			</div>
		</section>
	)}
</BaseLayout>
