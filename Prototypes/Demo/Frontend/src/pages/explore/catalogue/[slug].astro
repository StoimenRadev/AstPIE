---
// A catalogue object, opened in the observatory logbook
import DeskPage from '../../../components/explore/DeskPage.astro';
import { getCatalogueObject } from '../../../lib/api';
import { toDeskObject } from '../../../lib/desk';

const item = await getCatalogueObject(String(Astro.params.slug));
if (item === null)
{
	return Astro.rewrite('/404');
}
---

<DeskPage title={item.name} description={item.summary} mode="cat" data={toDeskObject(item)} />
