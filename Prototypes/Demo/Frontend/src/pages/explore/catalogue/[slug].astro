---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { t } from '../../../i18n/t';
import { getCatalogueObject } from '../../../lib/api';
import { formatDistance, formatMass, formatRadius, formatValue, objectTypeLabel } from '../../../lib/format';
import { renderMarkdown } from '../../../lib/markdown';

const item = await getCatalogueObject(String(Astro.params.slug));
if (item === null)
{
	return Astro.rewrite('/404');
}

// Every fact is shown; values that are not known say so instead of being left out
const facts = [
	{ label: t('catalogue.type'), value: objectTypeLabel(item.type) },
	{ label: t('catalogue.otherNames'), value: formatValue(item.otherNames) },
	{ label: t('catalogue.constellation'), value: formatValue(item.constellation) },
	{ label: t('catalogue.distance'), value: formatDistance(item.distanceLy) },
	{ label: t('catalogue.mass'), value: formatMass(item.massKg, item.type) },
	{ label: t('catalogue.radius'), value: formatRadius(item.radiusKm, item.type) },
	{ label: t('catalogue.magnitude'), value: formatValue(item.apparentMagnitude) },
	{ label: t('catalogue.discoveredBy'), value: formatValue(item.discoveredBy) },
	{ label: t('catalogue.discoveryYear'), value: formatValue(item.discoveryYear) }
];

const descriptionHtml = renderMarkdown(item.description);
---

<BaseLayout title={item.name}>
	<article>
		<p class="back"><a href="/explore/catalogue">← {t('entry.back')}</a></p>
		<h1>{item.name}</h1>
		<p class="summary">{item.summary}</p>

		<table class="facts">
			<tbody>
				{facts.map((fact) => (
					<tr>
						<th scope="row">{fact.label}</th>
						<td>{fact.value}</td>
					</tr>
				))}
			</tbody>
		</table>

		<div class="description" set:html={descriptionHtml} />

		{item.relatedTopic !== null && (
			<section class="physics">
				<h2>{t('entry.physics')}</h2>
				<a href={'/learn/' + item.relatedTopic.slug}>{item.relatedTopic.title} →</a>
			</section>
		)}
	</article>
</BaseLayout>

<style>
	article {
		max-width: 44rem;
	}

	.back {
		margin: 0;
		font-size: 0.875rem;
	}

	.summary {
		font-size: 1.25rem;
		color: var(--color-muted);
	}

	.facts {
		width: 100%;
		margin-top: var(--space-4);
		border-collapse: collapse;
	}

	.facts th,
	.facts td {
		padding: var(--space-2) 0;
		border-bottom: 1px solid var(--color-border);
		text-align: left;
		vertical-align: top;
	}

	.facts th {
		width: 45%;
		padding-right: var(--space-3);
		color: var(--color-muted);
		font-weight: 400;
	}

	.description {
		margin-top: var(--space-5);
	}

	.physics {
		margin-top: var(--space-5);
	}

	.physics a {
		font-weight: 600;
	}
</style>
