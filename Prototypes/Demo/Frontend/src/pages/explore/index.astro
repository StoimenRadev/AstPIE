---
import BaseLayout from '../../layouts/BaseLayout.astro';
import MysteryBoard from '../../components/MysteryBoard.astro';
import Slot from '../../components/Slot.astro';
import YearLine from '../../components/YearLine.astro';
import { t } from '../../i18n/t';
import { getAllCatalogue, getEntries } from '../../lib/api';
import { objectTypeLabel } from '../../lib/format';

const missions = await getEntries('Mission');
const mysteries = await getEntries('Mystery');
const objects = (await getAllCatalogue()).items.slice(0, 4);
---

<BaseLayout title={t('explore.title')} theme="home" bodyClass="">
	<div class="wrap top">
		<h1 class="t-page">{t('explore.title')}</h1>
		<p class="intro">{t('explore.intro')}</p>
	</div>

	<section class="band m">
		<div class="wrap">
			<div class="hd"><div><h2>{t('missions.title')}</h2><p>{t('explore.missionsText')}</p></div><a class="go" href="/explore/missions">{t('entry.allMissions')} <svg><use href="#i-arrow" /></svg></a></div>
			<YearLine missions={missions} />
		</div>
	</section>

	<section class="band n">
		<div class="wrap">
			<div class="hd"><div><h2>{t('mysteries.title')}</h2><p>{t('explore.mysteriesText')}</p></div><a class="go" href="/explore/mysteries">{t('entry.allMysteries')} <svg><use href="#i-arrow" /></svg></a></div>
			<MysteryBoard mysteries={mysteries} headings={false} />
		</div>
	</section>

	<section class="band y">
		<div class="wrap">
			<div class="hd"><div><h2>{t('catalogue.title')}</h2><p>{t('explore.catalogueText')}</p></div><a class="go" href="/explore/catalogue">{t('entry.allObjects')} <svg><use href="#i-arrow" /></svg></a></div>
			<form class="search" action="/explore/catalogue" method="get" style="margin:0 0 26px">
				<input type="search" name="q" placeholder={t('catalogue.searchHint')} aria-label={t('catalogue.search')} />
				<button class="btn" type="submit">{t('catalogue.search')}</button>
			</form>
			<div class="objs">
				{objects.map((item) => (
					<a href={'/explore/catalogue/' + item.slug}>
						<Slot src={item.imageUrl} ratio="1 / 1" empty={t('common.noImage')} className="" />
						<b>{item.name}</b>
						<span>{objectTypeLabel(item.type)}{item.constellation !== null && ' · ' + item.constellation}</span>
					</a>
				))}
			</div>
		</div>
	</section>
</BaseLayout>

<style is:global>
	main:has(.band.y) + .foot { margin-top: 0; }
</style>
