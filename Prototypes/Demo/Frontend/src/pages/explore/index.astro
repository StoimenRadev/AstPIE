---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { t } from '../../i18n/t';
import { getCatalogue, getEntries } from '../../lib/api';

const missions = await getEntries('Mission');
const mysteries = await getEntries('Mystery');
const catalogue = await getCatalogue();
---

<BaseLayout title={t('explore.title')}>
	<h1>{t('explore.title')}</h1>
	<p>{t('explore.intro')}</p>

	<div class="sections">
		<a href="/explore/missions">
			<h2>{t('missions.title')}</h2>
			<p>{t('missions.description')}</p>
			<span class="count">{missions.length} {t('explore.count')}</span>
		</a>
		<a href="/explore/mysteries">
			<h2>{t('mysteries.title')}</h2>
			<p>{t('mysteries.description')}</p>
			<span class="count">{mysteries.length} {t('explore.count')}</span>
		</a>
		<a href="/explore/catalogue">
			<h2>{t('catalogue.title')}</h2>
			<p>{t('catalogue.description')}</p>
			<span class="count">{catalogue.totalCount} {t('explore.objects')}</span>
		</a>
	</div>
</BaseLayout>

<style>
	.sections {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
		gap: var(--space-3);
		margin-top: var(--space-4);
	}

	.sections a {
		display: block;
		padding: var(--space-4);
		border: 1px solid var(--color-border);
		border-radius: 0.5rem;
		color: var(--color-text);
		text-decoration: none;
	}

	.sections a:hover {
		background: var(--color-surface);
	}

	.sections h2 {
		margin-top: 0;
	}

	.sections p {
		color: var(--color-muted);
	}

	.count {
		font-size: 0.875rem;
		font-weight: 600;
	}
</style>
