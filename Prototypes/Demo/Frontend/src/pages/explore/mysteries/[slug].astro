---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import EntryPage from '../../../components/EntryPage.astro';
import { getEntry } from '../../../lib/api';

const entry = await getEntry(String(Astro.params.slug));

// A mission opened under /mysteries is the wrong address: show the 404 page
if (entry === null || entry.kind !== 'Mystery')
{
	return Astro.rewrite('/404');
}
---

<BaseLayout title={entry.title} theme="mysteries">
	<EntryPage entry={entry} basePath="/explore/mysteries" scene="scene-mysteries" />
</BaseLayout>
