---
// A mystery, opened on the evidence board of the mystery desk
import DeskPage from '../../../components/explore/DeskPage.astro';
import { getEntry, getTopic } from '../../../lib/api';
import { toDeskCase } from '../../../lib/desk';

const entry = await getEntry(String(Astro.params.slug));

// A mission opened under /mysteries is the wrong address: show the 404 page
if (entry === null || entry.kind !== 'Mystery')
{
	return Astro.rewrite('/404');
}

let topic = null;
if (entry.relatedTopic !== null)
{
	topic = await getTopic(entry.relatedTopic.slug);
}
---

<DeskPage title={entry.title} description={entry.tagline || entry.title} mode="case" data={toDeskCase(entry, topic)} />
