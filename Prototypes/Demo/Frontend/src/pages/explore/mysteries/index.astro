---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import MysteryBoard from '../../../components/MysteryBoard.astro';
import { t } from '../../../i18n/t';
import { getEntries } from '../../../lib/api';

const mysteries = await getEntries('Mystery');
---

<BaseLayout title={t('mysteries.title')} theme="mysteries" bodyClass="">
	<div class="wrap top">
		<h1 class="t-page">{t('mysteries.title')}</h1>
		<p class="intro">{t('mysteries.description')}</p>
	</div>
	<div class="wrap">
		{mysteries.length === 0 && <p class="intro">{t('mysteries.empty')}</p>}
		{mysteries.length > 0 && <MysteryBoard mysteries={mysteries} headings={true} />}
	</div>
</BaseLayout>
