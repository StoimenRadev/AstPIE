---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import EntryList from '../../../components/EntryList.astro';
import { t } from '../../../i18n/t';
import { getEntries } from '../../../lib/api';

const mysteries = await getEntries('Mystery');
---

<BaseLayout title={t('mysteries.title')}>
	<h1>{t('mysteries.title')}</h1>
	<p>{t('mysteries.description')}</p>

	{mysteries.length === 0 && <p>{t('mysteries.empty')}</p>}
	<EntryList entries={mysteries} basePath="/explore/mysteries" />
</BaseLayout>
