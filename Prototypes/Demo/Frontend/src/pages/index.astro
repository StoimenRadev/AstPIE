---
import BaseLayout from '../layouts/BaseLayout.astro';
import HomeHeroArt from '../components/HomeHeroArt.astro';
import { t } from '../i18n/t';
---

<BaseLayout title={t('home.title')} theme="home">
	<meta slot="head" name="description" content={t('home.description')} />

	<section class="home-hero">
		<HomeHeroArt />
		<div class="copy wrap">
			<h1>{t('home.heading')}</h1>
			<p class="lede">{t('home.tagline')}</p>
			<div class="actions">
				<a class="btn" href="/learn">{t('home.startLearning')} <span aria-hidden="true">→</span></a>
				<a class="btn quiet" href="/explore">{t('home.explore')}</a>
			</div>
		</div>
	</section>
</BaseLayout>

<style is:global>
	/* The home page is one screen: the picture only, no footer and no scrolling */
	html:has(.home-hero),
	html:has(.home-hero) body { height: 100%; overflow: hidden; }
	.page:has(.home-hero) { min-height: 0; }
	.page:has(.home-hero) .foot { display: none; }
	.page:has(.home-hero) .home-hero { height: 100vh; height: 100dvh; min-height: 0; }
</style>
